// One closed native-curve upper-lash region per eye. Continuous geometric
// area times existing sampled occlusion sets the budget; no source-alpha gate.
void LashCounts583(int2 p,int eye,out float4 counts,out float2 curveMean){counts=0;curveMean=0;bool closed=_UseLashRegion583!=0&&_UseClosedLash590!=0;
