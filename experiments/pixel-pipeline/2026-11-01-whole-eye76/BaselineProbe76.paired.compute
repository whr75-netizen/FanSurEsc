 }
 if(whiteCandidates==1&&SourceWhiteNeighbour19(p,eye))return false;
 float ownCost=max(own.a.y,IrisCount19(own))-own.b.y;int rank=0;
 for(int rankY=_ROI348.y;rankY<_ROI348.y+_ROI348.w;rankY++)for(int rankX=_ROI348.x;rankX<_ROI348.x+_ROI348.z;rankX++){
