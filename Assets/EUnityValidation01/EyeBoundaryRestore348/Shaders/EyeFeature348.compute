#pragma kernel Evaluate
#pragma kernel UnpackA
#pragma kernel UnpackB
#pragma kernel Merge
Texture2D<float4> _S0RGBA,_S0META,_S0POINT,_S0UV,_S1RGBA,_S1META,_S1POINT,_S1UV,_S2RGBA,_S2META,_S2POINT,_S2UV,_S3RGBA,_S3META,_S3POINT,_S3UV,_S4RGBA,_S4META,_S4POINT,_S4UV,_S5RGBA,_S5META,_S5POINT,_S5UV,_S6RGBA,_S6META,_S6POINT,_S6UV;
Texture2D<float4> _BaseRGBA,_BaseMETA,_BackingRGBA,_BackingMETA,_HairRGBA,_HairMETA,_BrowRGBA,_BrowMETA,_RawMETA,_RawUV,_PostLine,_TemplateRGBA,_TemplateRole,_OldEyeOwner,_OldIntrinsic;
RWTexture2D<float4> _Before,_Colour,_Owner,_PreparedMeta,_PreparedUV,_ResolvedMeta,_ResolvedUV,_OldDomain;
RWTexture2D<float4> _Output348,_Owner348,_Intrinsic348,_Visible348,_HistA348,_HistB348,_Surface348,_Pigment348,_Audit348,_Domain348,_Bary348,_SupportMeta348;
struct Pixel348{float4 colour,owner,intrinsic,visible,histA,histB,surface,pigment,audit,domain,bary,globalOwner,preparedMeta,preparedUV,control,supportMeta;};
RWStructuredBuffer<Pixel348> _RecordsWrite348;StructuredBuffer<Pixel348> _RecordsRead348;
Texture2D<float4> _BaselineColour348,_BaselineOwner348,_BaselineMeta348,_BaselineUV348,_BaselineDomain348;
StructuredBuffer<float4> _RestTriangles348;float4 _TriangleRanges348[16];
int4 _ROI348;float4 _Centres348[2],_AxesX348[2],_AxesY348[2],_UpperLower348,_Iris348,_Catch348,_FaceLidShade348;
float4x4 _Inverse348_0,_Inverse348_1,_WorldToHead348;float4 _Plane348_0,_Plane348_1,_RayBase348,_RayX348,_RayY348,_RayDepth348;int4 _ColourBounds348_0,_ColourBounds348_1;
bool cov(float4 m){return m.x>0&&m.y>.5&&m.w>1e-6;}
float4 M(int s,int2 q){if(s==0)return _S0META.Load(int3(q,0));if(s==1)return _S1META.Load(int3(q,0));if(s==2)return _S2META.Load(int3(q,0));return _S3META.Load(int3(q,0));}
float4 P(int s,int2 q){if(s==0)return _S0POINT.Load(int3(q,0));if(s==1)return _S1POINT.Load(int3(q,0));if(s==2)return _S2POINT.Load(int3(q,0));return _S3POINT.Load(int3(q,0));}
float4 U(int s,int2 q){if(s==0)return _S0UV.Load(int3(q,0));if(s==1)return _S1UV.Load(int3(q,0));if(s==2)return _S2UV.Load(int3(q,0));return _S3UV.Load(int3(q,0));}
// Feature enum:1sclera,2irisTop,3irisBottom,4catch,5upperLash,6lowerLid,7weakUpperLash.
int Classify(float3 rest,int eye){float3 d=rest-_Centres348[eye].xyz;float u=dot(d,_AxesX348[eye].xyz)/_AxesX348[eye].w,v=-dot(d,_AxesY348[eye].xyz)/_AxesY348[eye].w;float up=_UpperLower348.x+_UpperLower348.y*u*u,lo=_UpperLower348.z+_UpperLower348.w*u*u;bool ap=abs(u)<=1.02&&v>=up&&v<=lo;bool lash=abs(u)<=1.08&&v>=up-.36&&v<=up+.22;bool lid=abs(u)<=.90&&v>lo&&v<=lo+.35;bool iris=ap&&!lash&&pow(abs(u)/_Iris348.x,_Iris348.w)+pow(abs(v+_Iris348.z)/_Iris348.y,_Iris348.w)<=1;int f=lid?6:0;if(ap&&!iris&&!lash)f=1;if(iris)f=v<.08?2:3;if(iris&&u>=_Catch348.x&&u<=_Catch348.y&&v>=_Catch348.z&&v<=_Catch348.w)f=4;if(lash)f=5;return f;}
int Choose(float c[8]){float ir=c[2]+c[3]+c[4],tot=c[5]+ir+c[1];if(tot>=4){if(c[5]>=5&&ir<=4)return 5;if(ir>=5){if(c[4]>=4)return 4;return c[2]>=c[3]?2:3;}if(c[1]>=3)return 1;if(c[5]>=3)return 7;}else if(c[6]>=5)return 6;return 0;}
bool sameFeature(int label,int winner){return winner==7?label==5:winner==2||winner==3||winner==4?label>=2&&label<=4:label==winner;}
float2 reference(float2 screen,int eye){float3 q=mul(eye==0?_Inverse348_0:_Inverse348_1,float4(screen,1,0)).xyz;return q.xy/q.z;}
float4 Own(float2 ref,int eye,int role,out float4 provenance){int id=(int)round(_Centres348[eye].w);int4 box=eye==0?_ColourBounds348_0:_ColourBounds348_1;float best=1e30;float4 c=0;provenance=0;for(int y=box.y;y<box.w;y++)for(int x=box.x;x<box.z;x++){float4 r=_TemplateRole.Load(int3(x,271-y,0));if(round(r.x)!=role||round(r.y)!=id)continue;float d=dot(float2(x+.75,y+.25)-ref,float2(x+.75,y+.25)-ref);if(d<best){best=d;c=_TemplateRGBA.Load(int3(x,271-y,0));provenance=float4(x,y,role,1);}}return c;}
float3 barycentric(float3 restPosition,int sourceRole,int primitive){int offset=(int)_TriangleRanges348[sourceRole].x+3*(primitive-1);float3 a=_RestTriangles348[offset].xyz,b=_RestTriangles348[offset+1].xyz,c=_RestTriangles348[offset+2].xyz;float3 e=b-a,f=c-a,d=restPosition-a;float ee=dot(e,e),ff=dot(f,f),ef=dot(e,f),de=dot(d,e),df=dot(d,f);float det=ee*ff-ef*ef;float v=(ff*de-ef*df)/max(det,1e-30),w=(ee*df-ef*de)/max(det,1e-30);return float3(1-v-w,v,w);}
[numthreads(8,8,1)]void Evaluate(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;float4 old=_BaselineColour348.Load(int3(p,0)),oldOwner=_BaselineOwner348.Load(int3(p,0)),oldMeta=_BaselineMeta348.Load(int3(p,0)),oldUV=_BaselineUV348.Load(int3(p,0));bool oldDomain=_BaselineDomain348.Load(int3(p,0)).x>.5;int2 lc=p-_ROI348.xy;bool inROI=all(lc>=0)&&all(lc<_ROI348.zw);float2 screen=float2(p.x+.5,271.5-p.y);
 Pixel348 record=(Pixel348)0;record.colour=old;record.owner=float4(oldOwner.x,oldMeta.z,oldOwner.z,0);record.globalOwner=oldOwner;record.preparedMeta=oldMeta;record.preparedUV=oldUV;_RecordsWrite348[p.y*480+p.x]=record;
 if(!inROI&&!oldDomain)return;
 int win=0,eyeWin=-1,repIndex=-1,supportWin=-1;float winCount=0,bestIntrinsicCount=0;int intrinsicWin=0,intrinsicEye=-1;float visibleHist[8],intrinsicHist[8];float4 histVisible=0,histIntrinsic=0;float noSupport=0,hairBlocked=0,bodyBlocked=0;float depthWin=0;float4 uvWin=0,restWin=0;int labels[16],supports[16];float depths[16],weights[16];
 for(int eye=0;eye<2;eye++){for(int z=0;z<8;z++){visibleHist[z]=0;intrinsicHist[z]=0;}int owner=(int)round(_Centres348[eye].w);
  for(int k=0;k<16;k++){labels[k]=0;supports[k]=-1;depths[k]=0;weights[k]=0;if(!inROI)continue;int2 q=lc*4+int2(k%4,k/4);float2 st=float2(p.x+(k%4+.5)/4,272-p.y-(k/4+.5)/4);float4 plane=eye==0?_Plane348_0:_Plane348_1;float3 near=_RayBase348.xyz+st.x*_RayX348.xyz+st.y*_RayY348.xyz;float planeDepth=-(dot(plane.xyz,near)+plane.w)/dot(plane.xyz,_RayDepth348.xyz);float3 hypothetical=mul(_WorldToHead348,float4(near+planeDepth*_RayDepth348.xyz,1)).xyz;
   int support=-1;for(int s=0;s<4;s++){float4 m=M(s,q);if(cov(m)&&round(m.z)==owner&&P(s,q).w>.5){support=s;break;}}float3 rest=support>=0?P(support,q).xyz:hypothetical;int feat=Classify(rest,eye);if(feat==0)continue;intrinsicHist[feat]++;if(feat==5||feat==6){support=-1;float4 skin=M(0,q),eyelineSample=M(3,q);if(cov(skin)&&round(skin.z)==owner&&P(0,q).w>.5)support=0;else if(feat==5&&cov(eyelineSample)&&round(eyelineSample.z)==owner&&P(3,q).w>.5)support=3;}
   labels[k]=feat;supports[k]=support;if(support<0){noSupport++;continue;}float4 meta=M(support,q);float depth=feat==5||feat==6?meta.x:planeDepth;depths[k]=depth;float weight=1;float4 hair=_S4META.Load(int3(q,0)),br=_S5META.Load(int3(q,0)),body=_S6META.Load(int3(q,0));if(cov(hair)&&hair.x<depth){weight*=1-saturate(hair.w);hairBlocked++;}if(cov(br)&&br.x<depth)weight*=1-saturate(br.w);if(cov(body)&&body.x<depth){weight=0;bodyBlocked++;}weights[k]=weight;visibleHist[feat]+=weight;
  }
  int iw=Choose(intrinsicHist);float ic=0;for(int k=1;k<8;k++)ic+=intrinsicHist[k];if(ic>bestIntrinsicCount){bestIntrinsicCount=ic;intrinsicWin=iw;intrinsicEye=eye;histIntrinsic=float4(intrinsicHist[5],intrinsicHist[2]+intrinsicHist[3]+intrinsicHist[4],intrinsicHist[1],intrinsicHist[6]);}
  int w=Choose(visibleHist);float count=w>=2&&w<=4?visibleHist[2]+visibleHist[3]+visibleHist[4]:w==7?visibleHist[5]:visibleHist[w];if(w>0&&count>winCount){float nearest=1e20;int idx=-1;for(int k=0;k<16;k++){if(!sameFeature(labels[k],w)||supports[k]<0||weights[k]<=0)continue;float2 d=(float2(k%4,k/4)+.5)/4-.5;float dd=dot(d,d);if(dd<nearest){nearest=dd;idx=k;}}if(idx>=0){win=w;eyeWin=eye;winCount=count;repIndex=idx;supportWin=supports[idx];depthWin=depths[idx];int2 q=lc*4+int2(idx%4,idx/4);uvWin=U(supportWin,q);restWin=P(supportWin,q);histVisible=float4(visibleHist[5],visibleHist[2]+visibleHist[3]+visibleHist[4],visibleHist[1],visibleHist[6]);}}
 }
 bool domain=oldDomain||bestIntrinsicCount>0;if(!domain)return;int selectedEye=eyeWin>=0?eyeWin:intrinsicEye;float eyeId=selectedEye>=0?_Centres348[selectedEye].w:_OldIntrinsic.Load(int3(p,0)).y;if(eyeId<=0)eyeId=_OldEyeOwner.Load(int3(p,0)).y;
 float4 bm=_BaseMETA.Load(int3(p,0)),bc=_BaseRGBA.Load(int3(p,0)),back=_BackingMETA.Load(int3(p,0));if(cov(back)&&(!cov(bm)||back.x<bm.x)){bm=back;bc=_BackingRGBA.Load(int3(p,0));}float4 c=cov(bm)?float4(bc.rgb,1):0;float4 o=cov(bm)?float4(bm.y,bm.z,bm.x,0):0;float4 pig=0,surfaceSupport=0,baryResult=0;float status=cov(bm)?0:1;int visibleFeature=win;
 if(win>0){float2 st=float2(p.x+(repIndex%4+.5)/4,272-p.y-(repIndex/4+.5)/4);float4 colour=0;if(win==6){colour=_FaceLidShade348;pig=float4(0,0,3,3);}else if(win==5||win==7){float best=1e30;for(int y=0;y<_ROI348.w*4;y++)for(int x=0;x<_ROI348.z*4;x++){float4 m=_S3META.Load(int3(x,y,0));if(!cov(m)||round(m.z)!=(int)round(eyeId))continue;float2 d=float2(x+.5,y+.5)-(float2(lc*4)+float2(repIndex%4+.5,repIndex/4+.5));float dd=dot(d,d);if(dd<best){best=dd;colour=_S3RGBA.Load(int3(x,y,0));float4 uv=_S3UV.Load(int3(x,y,0));pig=float4(uv.xy,6,2);}}}else{colour=Own(reference(st,selectedEye),selectedEye,win==1?4:1,pig);}
  if(colour.a>0){int role=win==1?4:(win==5||win==7)?6:win==6?3:1;c=float4(colour.rgb,1);o=float4(role+1,eyeId,depthWin,1);surfaceSupport=float4(uvWin.xy,uvWin.z,supportWin+1);int sr=supportWin==0?3:supportWin==1?4:supportWin==2?1:6;baryResult=float4(barycentric(restWin.xyz,sr,(int)round(uvWin.z)),sr+1);status=0;}else{status=2;visibleFeature=0;}
 }
 float4 hair=_HairMETA.Load(int3(p,0)),brow=_BrowMETA.Load(int3(p,0)),raw=_RawMETA.Load(int3(p,0));bool rawBody=cov(raw)&&round(raw.y)>=8&&round(raw.y)<=11;
 if(cov(hair)&&hair.x<o.z){float4 hc=_HairRGBA.Load(int3(p,0));float3 hcRGB=hc.rgb;if(round(oldMeta.y)==round(hair.y)&&oldOwner.z==hair.x)hcRGB=old.rgb;else if(round(raw.y)==round(hair.y))hcRGB=_PostLine.Load(int3(p,0)).rgb;c=float4(lerp(c.rgb,hcRGB,saturate(hair.w)),1);o=float4(hair.y,hair.z,hair.x,3);visibleFeature=0;}
 if(cov(brow)&&brow.x<o.z&&(!cov(hair)||hair.x>=brow.x)){float4 br=_BrowRGBA.Load(int3(p,0));c=float4(lerp(c.rgb,br.rgb,saturate(brow.w)),1);o=float4(brow.y,brow.z,brow.x,4);visibleFeature=0;}
 bool preserveBody=rawBody&&raw.x<o.z;if(preserveBody){c=old;o=float4(oldOwner.x,oldMeta.z,oldOwner.z,5);visibleFeature=0;}
 record.colour=c;record.owner=o;record.intrinsic=float4(intrinsicWin,eyeId,bestIntrinsicCount,1);record.visible=float4(visibleFeature,eyeId,winCount,repIndex);record.histA=histVisible;record.histB=histIntrinsic;record.surface=surfaceSupport;record.pigment=pig;record.audit=float4(status,noSupport,hairBlocked,bodyBlocked);record.domain=float4(1,oldDomain?1:0,bestIntrinsicCount>0?1:0,0);record.bary=baryResult;if(supportWin>=0&&repIndex>=0){int2 sq=lc*4+int2(repIndex%4,repIndex/4);float4 sm=M(supportWin,sq);record.supportMeta=float4(sm.x,sm.y,sm.w,(win==5||win==6||win==7)?0:1);}record.control=float4(1,preserveBody?1:0,0,0);
 if(!preserveBody){int resolvedRole=(int)round(o.x)-1;float part=resolvedRole>=11?7:resolvedRole<=6?6:oldOwner.y;record.globalOwner=float4(o.x,part,o.z,0);record.preparedUV=visibleFeature>0?float4(uvWin.xy,0,1):_RawUV.Load(int3(p,0));float primitive=visibleFeature>0?uvWin.z:raw.w;record.preparedMeta=float4(o.z,o.x,o.y,primitive);}_RecordsWrite348[p.y*480+p.x]=record;
}

[numthreads(8,8,1)]void UnpackA(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;Pixel348 r=_RecordsRead348[p.y*480+p.x];_Output348[p]=r.colour;_Owner348[p]=r.owner;_Intrinsic348[p]=r.intrinsic;_Visible348[p]=r.visible;_HistA348[p]=r.histA;_HistB348[p]=r.histB;_Surface348[p]=r.surface;_Pigment348[p]=r.pigment;}
[numthreads(8,8,1)]void UnpackB(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;Pixel348 r=_RecordsRead348[p.y*480+p.x];_Audit348[p]=r.audit;_Domain348[p]=r.domain;_Bary348[p]=r.bary;_SupportMeta348[p]=r.supportMeta;}
[numthreads(8,8,1)]void Merge(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;Pixel348 r=_RecordsRead348[p.y*480+p.x];if(r.control.x<.5)return;_OldDomain[p]=r.domain;if(r.control.y>.5)return;_Before[p]=r.colour;_Colour[p]=r.colour;_Owner[p]=r.globalOwner;_PreparedMeta[p]=r.preparedMeta;_PreparedUV[p]=r.preparedUV;_ResolvedMeta[p]=float4(r.preparedMeta.x,r.preparedMeta.y,r.preparedMeta.z,r.globalOwner.w);_ResolvedUV[p]=r.preparedUV;}
