// Existing302 endpoint/classifier outputs only. No changes to source, coverage, owner or depth.
Texture2D<float4> _Map335,_CurrentMeta335,_CurrentUV335,_CurrentRaw335,_NativeMeta335,_NativeUV335,_NativeRaw335,_StockMember335;
Texture2D<float4> _LegacyColour480,_LegacyLit480,_LegacyShade480,_LegacyClass480,_LegacyColour960,_LegacyLit960,_LegacyShade960,_LegacyClass960;
