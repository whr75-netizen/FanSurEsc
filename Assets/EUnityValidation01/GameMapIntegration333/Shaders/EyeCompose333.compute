bool cov(float4 m){return m.y>.5&&m.x>0;}
[numthreads(8,8,1)]void Compose(uint3 gid:SV_DispatchThreadID){int2 p=int2(gid.xy);if(p.x>=_LogicalSize.x||p.y>=_LogicalSize.y)return;int2 top=int2(p.x,_LogicalSize.y-1-p.y);int2 n=_CellSize*p+int2((int)floor(_CellSize*.75),_CellSize-1-(int)floor(_CellSize*.25));int3 np=int3(n,0);float2 screen=float2(top)+float2(.5,.5);float4 r0=template262(screen,0),r1=template262(screen,1);float4 tr=r0.x>.5?r0:r1;int ei=round(tr.y)==2?0:1;float2 ref=local262(screen,ei);int2 oldTop=(int2)floor(ref);int colourSupport=0;float4 tc=0;if(tr.x>.5)tc=ownColour295(ref,ei,(int)round(tr.x),colourSupport);bool ap=tr.x>.5;float4 fm=_OriginalFullMeta.Load(np),bm=_BaseMETA.Load(np),bc=_BaseRGBA.Load(np),allHair=_AllHairMETA.Load(np),tagged=_TaggedHairMETA.Load(np),other=_OtherHairMETA.Load(np),brow=_BrowMETA.Load(np);bool selected=cov(tagged)&&_TaggedHairUV.Load(np).w>.5&&cov(allHair)&&round(allHair.y)==12&&abs(tagged.x-allHair.x)<=.00002;
