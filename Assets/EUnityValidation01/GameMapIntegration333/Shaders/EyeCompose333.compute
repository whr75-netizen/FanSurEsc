  if(cov(other)&&other.x<closest){float4 hc=_OtherHairRGBA.Load(np);c=float4(lerp(tc.rgb,hc.rgb,saturate(other.w)),1);owner=float4(other.y,other.z,other.x,3);closest=other.x;}
  // The selected strand yields only to authored eye pixels; all hair still hides brow.
  if(cov(brow)&&brow.x<closest&&!browHidden){float4 br=_BrowRGBA.Load(np);c=float4(lerp(tc.rgb,br.rgb,saturate(brow.w)),1);owner=float4(brow.y,brow.z,brow.x,4);closest=brow.x;}
  audit.y=colourSupport;audit.z=selected?1:0;float4 sk=_BackingMETA.Load(np);audit.w=cov(sk)&&sk.x<depth?1:0;
 }
 _Colour[p]=c;_Owner[p]=owner;_Intrinsic[p]=intrinsic;_Audit[p]=audit;
