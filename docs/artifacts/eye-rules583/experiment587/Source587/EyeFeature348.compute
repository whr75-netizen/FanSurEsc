// Feature enum:1sclera,2irisTop,3irisBottom,4catch,5upperLash,6lowerLid,7weakUpperLash.
int Classify(float3 rest,int eye){float3 d=rest-_Centres348[eye].xyz;float u=dot(d,_AxesX348[eye].xyz)/_AxesX348[eye].w,v=-dot(d,_AxesY348[eye].xyz)/_AxesY348[eye].w;float up=_UpperLower348.x+_UpperLower348.y*u*u,lo=_UpperLower348.z+_UpperLower348.w*u*u;bool ap=abs(u)<=1.02&&v>=up&&v<=lo;bool lash=abs(u)<=1.08&&v>=up-.36&&v<=up+.22;bool lid=abs(u)<=.90&&v>lo&&v<=lo+.35;bool iris=ap&&!lash&&pow(abs(u)/_Iris348.x,_Iris348.w)+pow(abs(v+_Iris348.z)/_Iris348.y,_Iris348.w)<=1;int f=lid?6:0;if(ap&&!iris&&!lash)f=1;if(iris)f=v<.08?2:3;if(iris&&u>=_Catch348.x&&u<=_Catch348.y&&v>=_Catch348.z&&v<=_Catch348.w)f=4;if(lash)f=5;return f;}
struct FeatureSample583{int feat,support;float depth,weight,hairBlocked,bodyBlocked;float3 rest;};
FeatureSample583 Sample583(int2 p,int eye,int k){FeatureSample583 r=(FeatureSample583)0;r.support=-1;int owner=(int)round(_Centres348[eye].w);int2 lc=p-_ROI348.xy;
int2 q=lc*4+int2(k%4,k/4);float2 st=float2(p.x+(k%4+.5)/4,272-p.y-(k/4+.5)/4);float4 plane=eye==0?_Plane348_0:_Plane348_1;float3 near=_RayBase348.xyz+st.x*_RayX348.xyz+st.y*_RayY348.xyz;float planeDepth=-(dot(plane.xyz,near)+plane.w)/dot(plane.xyz,_RayDepth348.xyz);float3 hypothetical=mul(_WorldToHead348,float4(near+planeDepth*_RayDepth348.xyz,1)).xyz;
   int support=-1;for(int s=0;s<4;s++){float4 m=M(s,q);if(cov(m)&&round(m.z)==owner&&P(s,q).w>.5){support=s;break;}}float3 rest=support>=0?P(support,q).xyz:hypothetical;int feat=Classify(rest,eye);if(feat==0)return r;r.feat=feat;r.rest=rest;if(feat==5||feat==6){support=-1;float4 skin=M(0,q),eyelineSample=M(3,q);if(cov(skin)&&round(skin.z)==owner&&P(0,q).w>.5)support=0;else if(feat==5&&cov(eyelineSample)&&round(eyelineSample.z)==owner&&P(3,q).w>.5)support=3;}
   // Classification is the existing model-bound design geometry. Its reference
   // surface is not permission for skin to supply iris/catch visibility.
   float sourceWeight582=1;
   if(_UseIrisSurface582!=0&&feat>=2&&feat<=4){
    float4 irisSource=M(2,q),skinSource=M(0,q);support=-1;
    if(cov(irisSource)&&round(irisSource.z)==owner&&P(2,q).w>.5){
     support=2;sourceWeight582=saturate(irisSource.w);
     if(cov(skinSource)&&skinSource.x<irisSource.x)sourceWeight582*=1-saturate(skinSource.w);
    }
   }
   r.support=support;if(support<0)return r;float4 meta=M(support,q);float depth=feat==5||feat==6?meta.x:planeDepth;float weight=sourceWeight582;float4 hair=_UseHairRegion502!=0?_HairMETA.Load(int3(p,0)):_S4META.Load(int3(q,0)),br=_S5META.Load(int3(q,0)),body=_S6META.Load(int3(q,0));if(cov(hair)&&hair.x<depth){weight*=1-saturate(hair.w);r.hairBlocked=1;}if(cov(br)&&br.x<depth)weight*=1-saturate(br.w);if(cov(body)&&body.x<depth){weight=0;r.bodyBlocked=1;}r.depth=depth;r.weight=weight;return r;
}
int Choose(float c[8]){float ir=c[2]+c[3]+c[4],tot=c[5]+ir+c[1];if(tot>=4){if(c[5]>=5&&ir<=4)return 5;if(ir>=5){if(c[4]>=4)return 4;return c[2]>=c[3]?2:3;}if(c[1]>=3)return 1;if(c[5]>=3)return 7;}else if(c[6]>=5)return 6;return 0;}
// One model-bound upper-lash feature per eye. Current visible support sets its
// area budget; there is no minimum pixel count or previous-frame state.
void LashCounts583(int2 p,int eye,out float4 counts,out float2 curveMean){counts=0;curveMean=0;
 for(int k=0;k<16;k++){FeatureSample583 a=Sample583(p,eye,k);if(a.support<0||a.weight<=0)continue;
  if(a.feat==5){counts.x+=a.weight;float3 d=a.rest-_Centres348[eye].xyz;curveMean+=a.weight*float2(dot(d,_AxesX348[eye].xyz)/_AxesX348[eye].w,-dot(d,_AxesY348[eye].xyz)/_AxesY348[eye].w);}
  else if(a.feat>=2&&a.feat<=4)counts.y+=a.weight;else if(a.feat==1)counts.z+=a.weight;else if(a.feat==6)counts.w+=a.weight;
 }if(counts.x>0)curveMean/=counts.x;
}
bool LashBefore583(float4 a,float2 au,int2 ap,float4 b,float2 bu,int2 bp){
 float ac=max(max(a.y,a.z),a.w)-a.x,bc=max(max(b.y,b.z),b.w)-b.x;
 if(ac!=bc)return ac<bc;if(au.x!=bu.x)return au.x<bu.x;if(au.y!=bu.y)return au.y<bu.y;
 // Exact numerical tie only: canonical grid order, not a model/view exception.
 return ap.y!=bp.y?ap.y<bp.y:ap.x<bp.x;
}
bool LashAllocated583(int2 p,int eye){float4 own;float2 ownU;LashCounts583(p,eye,own,ownU);if(own.x<=0)return false;
 float area=0;int rank=0;for(int y=_ROI348.y;y<_ROI348.y+_ROI348.w;y++)for(int x=_ROI348.x;x<_ROI348.x+_ROI348.z;x++){
  int2 q=int2(x,y);float4 c;float2 u;LashCounts583(q,eye,c,u);if(c.x<=0)continue;area+=c.x/16;
  if(LashBefore583(c,u,q,own,ownU,p))rank++;
 }if(_UseLashArea587!=0)area=_LashArea587[eye].x;return rank<(int)floor(area+.5);
}

bool AreaCov587(float4 m){return m.x>0&&m.y>1e-6;}
bool AreaEye587(float4 m,int owner){return AreaCov587(m)&&round(m.z)==owner;}
float AreaWeight587(int2 q){
 int owner=(int)round(_Centres348[_AreaEyeIndex587].w);
 float4 skin=_A0_587.Load(int3(q,0)),white=_A1_587.Load(int3(q,0)),iris=_A2_587.Load(int3(q,0)),eyeline=_A3_587.Load(int3(q,0));
 float4 reference=AreaEye587(skin,owner)?skin:AreaEye587(white,owner)?white:AreaEye587(iris,owner)?iris:AreaEye587(eyeline,owner)?eyeline:0;
 if(reference.w<.5)return 0;
 float4 support=AreaEye587(skin,owner)?skin:AreaEye587(eyeline,owner)?eyeline:0;
 if(!AreaCov587(support))return 0;
 int2 p=_AreaBox587.xy+q/_AreaDensity587;
 float4 hair=_UseHairRegion502!=0?_HairMETA.Load(int3(p,0)):_A4_587.Load(int3(q,0));
 float weight=1;
 // Packet META has depth/role/owner/alpha, area signals have depth/alpha.
 if(_UseHairRegion502!=0){if(cov(hair)&&hair.x<support.x)weight*=1-saturate(hair.w);}
 else if(AreaCov587(hair)&&hair.x<support.x)weight*=1-saturate(hair.y);
 float4 brow=_A5_587.Load(int3(q,0)),body=_A6_587.Load(int3(q,0));
 if(AreaCov587(brow)&&brow.x<support.x)weight*=1-saturate(brow.y);
 if(AreaCov587(body)&&body.x<support.x)weight=0;
 return weight;
}
groupshared float4 AreaSums587[64];
// Four interlaced64x64 rules retain the original source filter footprint.
// Their spread is an error estimate, not a proven bound or temporal filter.
[numthreads(64,1,1)]void IntegrateArea587(uint3 tid:SV_GroupThreadID,uint3 gid:SV_GroupID){
 int width=_AreaBox587.z*_AreaDensity587,height=_AreaBox587.w*_AreaDensity587;
 float4 sums=0;
 uint end=min((gid.x+1)*256,(uint)(width*height));
 [loop]for(uint k=gid.x*256+tid.x;k<end;k+=64){int2 q=int2(k%width,k/width);float w=AreaWeight587(q);int phase=(q.x&1)+2*(q.y&1);sums+=w*float4(phase==0,phase==1,phase==2,phase==3);}
 AreaSums587[tid.x]=sums;GroupMemoryBarrierWithGroupSync();
 for(uint stride=32;stride>0;stride>>=1){if(tid.x<stride)AreaSums587[tid.x]+=AreaSums587[tid.x+stride];GroupMemoryBarrierWithGroupSync();}
 if(tid.x==0)_AreaPartials587[gid.x]=AreaSums587[0];
}
[numthreads(64,1,1)]void FinalizeArea587(uint3 tid:SV_GroupThreadID){
 int width=_AreaBox587.z*_AreaDensity587,height=_AreaBox587.w*_AreaDensity587;uint count=(width*height+255)/256;float4 sums=0;
 [loop]for(uint k=tid.x;k<count;k+=64)sums+=_AreaPartials587[k];
 AreaSums587[tid.x]=sums;GroupMemoryBarrierWithGroupSync();
 for(uint stride=32;stride>0;stride>>=1){if(tid.x<stride)AreaSums587[tid.x]+=AreaSums587[tid.x+stride];GroupMemoryBarrierWithGroupSync();}
 if(tid.x==0){float4 phases=AreaSums587[0]*(4.0/(_AreaDensity587*_AreaDensity587));float area=dot(phases,float4(.25,.25,.25,.25));float error=2*max(max(abs(phases.x-area),abs(phases.y-area)),max(abs(phases.z-area),abs(phases.w-area)));_LashArea587[_AreaEyeIndex587]=float4(area,error,min(min(phases.x,phases.y),min(phases.z,phases.w)),max(max(phases.x,phases.y),max(phases.z,phases.w)));}
}
int ChooseRegion583(float c[8],int2 p,int eye){
 if(c[5]>0&&LashAllocated583(p,eye))return c[5]>=5?5:7;
 float ir=c[2]+c[3]+c[4],tot=c[5]+ir+c[1];
 if(tot>=4){if(ir>=5){if(c[4]>=4)return 4;return c[2]>=c[3]?2:3;}if(c[1]>=3)return 1;}
 else if(c[6]>=5)return 6;return 0;
}
bool sameFeature(int label,int winner){return winner==7?label==5:winner==2||winner==3||winner==4?label>=2&&label<=4:label==winner;}
float2 reference(float2 screen,int eye){float3 q=mul(eye==0?_Inverse348_0:_Inverse348_1,float4(screen,1,0)).xyz;return q.xy/q.z;}
float4 Own(float2 ref,int eye,int role,out float4 provenance){int id=(int)round(_Centres348[eye].w);int4 box=eye==0?_ColourBounds348_0:_ColourBounds348_1;float best=1e30;float4 c=0;provenance=0;for(int y=box.y;y<box.w;y++)for(int x=box.x;x<box.z;x++){float4 r=_TemplateRole.Load(int3(x,271-y,0));if(round(r.x)!=role||round(r.y)!=id)continue;float d=dot(float2(x+.75,y+.25)-ref,float2(x+.75,y+.25)-ref);if(d<best){best=d;c=_TemplateRGBA.Load(int3(x,271-y,0));provenance=float4(x,y,role,1);}}return c;}
float3 barycentric(float3 restPosition,int sourceRole,int primitive){int offset=(int)_TriangleRanges348[sourceRole].x+3*(primitive-1);float3 a=_RestTriangles348[offset].xyz,b=_RestTriangles348[offset+1].xyz,c=_RestTriangles348[offset+2].xyz;float3 e=b-a,f=c-a,d=restPosition-a;float ee=dot(e,e),ff=dot(f,f),ef=dot(e,f),de=dot(d,e),df=dot(d,f);float det=ee*ff-ef*ef;float v=(ff*de-ef*df)/max(det,1e-30),w=(ee*df-ef*de)/max(det,1e-30);return float3(1-v-w,v,w);}
[numthreads(8,8,1)]void Evaluate(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;float4 old=_BaselineColour348.Load(int3(p,0)),oldOwner=_BaselineOwner348.Load(int3(p,0)),oldMeta=_BaselineMeta348.Load(int3(p,0)),oldUV=_BaselineUV348.Load(int3(p,0));bool oldDomain=_BaselineDomain348.Load(int3(p,0)).x>.5;int2 lc=p-_ROI348.xy;bool inROI=all(lc>=0)&&all(lc<_ROI348.zw);float2 screen=float2(p.x+.5,271.5-p.y);
