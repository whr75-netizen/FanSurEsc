float2 TraceExternal24(float2 queryPoint,float depth,int eye){
 float2 trans=1;int stack[32],sp=0;stack[sp++]=0;uint visits=0,tests=0;bool overflow=false;
 while(sp>0){int node=stack[--sp];visits++;if(_NodeCount96<=0||(uint)node>=(uint)_NodeCount96||visits>(uint)_NodeCount96){overflow=true;break;}float3 lo=_Boxes96[node*2].xyz,hi=_Boxes96[node*2+1].xyz;if(any(queryPoint<lo.xy-1e-4)||any(queryPoint>hi.xy+1e-4)||lo.z>=depth-3e-5)continue;int4 nd=_Nodes96[node];if(nd.z<0){if(sp>29){overflow=true;break;}stack[sp++]=nd.x;stack[sp++]=nd.y;continue;}
  tests++;Tri96 t=_Triangles96[nd.z];if(t.source.x!=1||t.source.y!=3)continue;                                                                 
float3 s0=Screen96(t.verticesMaterial.x),s1=Screen96(t.verticesMaterial.y),s2=Screen96(t.verticesMaterial.z);float2 e0=s1.xy-s0.xy,e1=s2.xy-s0.xy,d=queryPoint-s0.xy;float determinant=Cross96(e0,e1);if(abs(determinant)<=1e-12)continue;int winding=determinant>0?1:-1;Mat96 m=_Materials96[t.verticesMaterial.w];int cull=(int)m.alphaCullWrap.z;if((cull==2&&winding!=1)||(cull==1&&winding==1))continue;float2 uvb=float2(Cross96(d,e1),Cross96(e0,d))/determinant;float3 weights=float3(1-uvb.x-uvb.y,uvb);if(min(weights.x,min(weights.y,weights.z))< -1e-7)continue;
  float4 cv0=mul(_Projection96,mul(_View96,_World96[t.verticesMaterial.x])),cv1=mul(_Projection96,mul(_View96,_World96[t.verticesMaterial.y])),cv2=mul(_Projection96,mul(_View96,_World96[t.verticesMaterial.z]));if(min(cv0.w,min(cv1.w,cv2.w))<=0)continue;weights/=float3(cv0.w,cv1.w,cv2.w);weights/=weights.x+weights.y+weights.z;float zz=dot(weights,float3(s0.z,s1.z,s2.z));if(zz>=depth-3e-5)continue;
  if((_OwnSkin113[t.source.z-1]&(1u<<eye))!=0&&depth-zz<=SocketLimit24(eye))continue;
  int otherEye=(int)floor(dot(weights,t.eyeOwners.xyz)+.5);if(t.source.x==1&&(t.source.y==1||t.source.y==2||t.source.y==4||t.source.y==6)&&otherEye==eye)continue;
  float2 uv=_UV96[t.verticesMaterial.x]*weights.x+_UV96[t.verticesMaterial.y]*weights.y+_UV96[t.verticesMaterial.z]*weights.z;float2 abounds=AlphaBounds96(t.verticesMaterial.w,uv);trans*=1-abounds.yx;if(trans.y<=0)break;
 }

