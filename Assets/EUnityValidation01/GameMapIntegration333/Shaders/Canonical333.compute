#pragma kernel CanonicalMetadata
Texture2D<float4> _CanonRaw,_CanonMeta,_CanonUV,_CanonNormal,_CanonFacing;
Texture2D<float4> _CreamMember333,_StockMember333,_SkinMember333;
SamplerState sampler_CreamMember333,sampler_StockMember333,sampler_SkinMember333;
StructuredBuffer<float4> _SourceTags333;
float4 _RoleRanges333[16];float4x4 _CanonView333;int2 _CanonSize333;
RWTexture2D<float4> _CanonSurfaceOut,_CanonNormalOut,_CanonFamilyOut;
[numthreads(8,8,1)]void CanonicalMetadata(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=_CanonSize333))return;float4 m=_CanonMeta.Load(int3(p,0)),s=_CanonRaw.Load(int3(p,0)),uv=_CanonUV.Load(int3(p,0));if(m.x<=0||s.a<=.000001){_CanonSurfaceOut[p]=0;_CanonNormalOut[p]=0;_CanonFamilyOut[p]=0;return;}int role=clamp((int)round(m.y)-1,0,15),primitive=(int)round(m.w)-1;float4 r=_RoleRanges333[role];float part=r.x,global=0;if(role>=7&&role<=10){float4 tag=_SourceTags333[(int)r.y+primitive];part=tag.x;global=tag.y>.5?-tag.z:tag.z;}_CanonSurfaceOut[p]=float4(m.x,m.y,part,global);float3 n=normalize(mul((float3x3)_CanonView333,_CanonNormal.Load(int3(p,0)).xyz));n*=_CanonFacing.Load(int3(p,0)).w;_CanonNormalOut[p]=float4(n,1);float family=0;if(role==10&&_CreamMember333.SampleLevel(sampler_CreamMember333,uv.xy,0).r>.5)family=3;if(role==7&&_StockMember333.SampleLevel(sampler_StockMember333,uv.xy,0).r<=.5&&_SkinMember333.SampleLevel(sampler_SkinMember333,uv.xy,0).r>.5)family=1;_CanonFamilyOut[p]=float4(family,m.y,m.x,s.a);}
