+using System;
+using System.Collections.Generic;
+
+// Diagnostic prototype. Continuous bounded gaps between consecutive positive
+// winding spans form units before grid selection; this never edits a raster mask.
+public sealed class NegativeSpan560
+{
+ struct PositiveSpan{public double l0,l1,r0,r1;}
+ sealed class Node{public int parent;public double l0,l1,r0,r1;public readonly List<int> cells=new List<int>();}
+ readonly int x0,y0,width,height,originalWidth;readonly bool transpose;
+ readonly List<PositiveSpan> positive=new List<PositiveSpan>();readonly List<Node> nodes=new List<Node>();
+ List<int> previous=new List<int>();double lo,hi,previousHi=double.NaN;
+ public NegativeSpan560(int x0,int y0,int width,int height,bool transpose=false){this.x0=x0;this.y0=y0;this.width=width;this.height=height;this.transpose=transpose;originalWidth=transpose?height:width;}
+ int Root(int i){while(nodes[i].parent!=i){nodes[i].parent=nodes[nodes[i].parent].parent;i=nodes[i].parent;}return i;}
+ public void BeginBand(double lo,double hi){this.lo=lo;this.hi=hi;positive.Clear();}
+ public void Positive(double l0,double l1,double r0,double r1){positive.Add(new PositiveSpan{l0=l0,l1=l1,r0=r0,r1=r1});}
+ public void EndBand()
+ {
+  var current=new List<int>();for(int i=0;i+1<positive.Count;i++)
+  {
+   var a=positive[i];var b=positive[i+1];double left0=a.r0,left1=a.r1,right0=b.l0,right1=b.l1;if((right0+right1-left0-left1)*.5<=1e-12)continue;
+   int id=nodes.Count;var n=new Node{parent=id,l0=left0,l1=left1,r0=right0,r1=right1};nodes.Add(n);current.Add(id);
+   if(previousHi==lo)foreach(int other in previous){var p=nodes[other];if(Math.Min(n.r0,p.r1)-Math.Max(n.l0,p.l1)>1e-12)nodes[Root(id)].parent=Root(other);}
+   for(int y=Math.Max(y0,(int)Math.Ceiling(lo-.5));y<y0+height&&y+.5<hi;y++)
+   {
+    double cy=y+.5;if(cy<lo)continue;double t=(cy-lo)/(hi-lo),left=left0+(left1-left0)*t,right=right0+(right1-right0)*t;
+    for(int x=Math.Max(x0,(int)Math.Ceiling(left-.5));x<x0+width&&x+.5<right;x++)if(x+.5>left)
+    {int cell=transpose?(x-x0)*originalWidth+y-y0:(y-y0)*originalWidth+x-x0;n.cells.Add(cell);}
+   }
+  }
+  previous=current;previousHi=hi;
+ }
+ public List<int[]> Features()
+ {
+  var components=new Dictionary<int,Dictionary<int,bool>>();for(int i=0;i<nodes.Count;i++){int root=Root(i);if(!components.TryGetValue(root,out var cells))components.Add(root,cells=new Dictionary<int,bool>());foreach(int cell in nodes[i].cells)cells[cell]=true;}
+  var result=new List<int[]>();foreach(var cells in components.Values){if(cells.Count==0)continue;var list=new List<int>(cells.Keys);list.Sort();result.Add(list.ToArray());}result.Sort((a,b)=>a[0].CompareTo(b[0]));return result;
+ }
+ // The two sweeps are joined only at an identical negative-region grid centre,
+ // never by an added radius. This treats horizontal and vertical gaps alike.
+ public static List<int[]> Merge(List<int[]> first,List<int[]> second)
+ {
+  var features=new List<int[]>(first);features.AddRange(second);var parent=new int[features.Count];for(int i=0;i<parent.Length;i++)parent[i]=i;
+  int RootOf(int i){while(parent[i]!=i){parent[i]=parent[parent[i]];i=parent[i];}return i;}
+  var owner=new Dictionary<int,int>();for(int i=0;i<features.Count;i++)foreach(int cell in features[i]){if(owner.TryGetValue(cell,out int old))parent[RootOf(i)]=RootOf(old);else owner.Add(cell,i);}
+  var components=new Dictionary<int,Dictionary<int,bool>>();for(int i=0;i<features.Count;i++){int root=RootOf(i);if(!components.TryGetValue(root,out var cells))components.Add(root,cells=new Dictionary<int,bool>());foreach(int cell in features[i])cells[cell]=true;}
+  var groups=new List<int[]>();foreach(var cells in components.Values){if(cells.Count<2)continue;var list=new List<int>(cells.Keys);list.Sort();groups.Add(list.ToArray());}groups.Sort((a,b)=>a[0].CompareTo(b[0]));return groups;
+ }
+}
