# Unity generated folders
/[lL]ibrary/
/[tT]emp/
/[bB]uilds/
/[oO]bj/

# Unity local/editor state
/[lL]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE generated files
/.vs/
/.vscode/
/.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.pdb
*.mdb
*.opendb
*.VC.db

# This project uses Git as its authoritative repository.
/.plastic/

# Unity crash/scene recovery snapshots are local safety artifacts, not source assets.
/Assets/_Recovery/
/Assets/_Recovery.meta

# Unity AI Assistant connection/checkpoint preferences contain machine-local paths
# and per-user tool state. The package version itself is tracked in Packages/.
/ProjectSettings/AI.Assistant/
/ProjectSettings/Packages/com.unity.ai.assistant/Settings.json

# Local design inputs, rendered images and downloaded tool dependencies stay ignored.
# Pixel-algorithm source/config/tests explicitly tracked by user request remain versioned.
/LocalOnly/
