 else{int eye=(int)round(tr.y);float4 plane=eye==2?_Plane262_0:_Plane262_1;float3 near=_RayBase.xyz+(top.x+.5)*_RayX.xyz+(top.y+.5)*_RayY.xyz;float depth=-(dot(plane.xyz,near)+plane.w)/dot(plane.xyz,_RayDepth.xyz);c=float4(tc.rgb,1);owner=float4(tr.x+1,eye,depth,1);intrinsic=float4(tr.x,eye,depth,selected?1:0);float closest=depth;bool baseIsSelected=selected&&round(bm.y)==12&&abs(bm.x-allHair.x)<=.00002;bool browHidden=cov(allHair)&&cov(brow)&&allHair.x<brow.x;
