// Experimental source-observed targets with optional persistent tone regions.
// This is not a fixed-tone shader or a temporal screen-image filter.
//
// Dispatch order (separate dispatches provide the global synchronization):
// Clear(1280,1,1), GatherGroups(ceil(W/8),ceil(H/8),1), GatherHistogram(same),
// SolveTones(160,1,1), GatherHighlights(same image grid), SolveHighlights(160,1,1),
// UpdateRegions(160,1,1), Resolve(same image grid), StoreHistory(160,1,1).
// The caller owns all resources.
//
// uint buffers / element counts (stride 4):
// Groups 160*8; Histogram 160*32*6; Tiles 160*16*3;
// TileHistogram 160*16*32; Supports 160*2; HighlightHistogram 160*32*5;
// Status 161. float4 buffers (stride 16): Palette 160*32; Solutions 160*3.
// PreviousHistory (read-only) / NextHistory: 160*34 float4 values each.
// History header 0: (asfloat(ColorKey), interval count, metric mode, valid).
// Header 1: (current mean scale, physical minimum, physical maximum, 0).
// Entries 2..33: (upper boundary / mean scale, representative metric / scale, 0, 0).
// This legacy partition history never contains RGB. The final boundary is unbounded.
// Region history is separate: 160*197 float4 values per ping-pong buffer.
// It holds ordered current/goal boundaries, region RGB, scale and accent support.
// Region mode may interpolate representative RGB over time; each region remains
// spatially flat. Current surface metrics select regions: no UV/motion-reprojected
// per-surface history is stored, so abrupt input-field changes can still pop.
//
// Deliberate differences from the Python reference:
// * A subject/part fence plus zero-centered chromaticity grid replaces connected
//   source domains / actual-center covering. Disconnected parts can share tones.
// * 32 adaptive histogram bins restrict partitions and representative candidates.
//   Each candidate is an ACTUAL dense-source RGB, never a bin-center/average RGB.
// * Moments use normalized-metric uint16 samples and exact uint64-pair atomic sums.
//   Representative choice uses a quantized bin-center distance, then pixel index.
// * Masked 4x4 -> 2x2 spatial tile means replace Gaussian scale-space supports.
//   Both scales need variance coherence >= .35 and support overlap >= .65.
//   This protects one broad contrast; it is not material or fine-edge recognition.
// * Fresh DP checks only the SSE-optimal candidate at each K against support
//   contrast. First passing K is NOT a global constrained minimum.
// Legacy temporal selection (region mode OFF) retains a feasible partition, reselecting
// actual CURRENT observed candidates. Only reducing K uses a stricter error
// limit; history never relaxes the current RMS/contrast conditions. Boundaries
// are projected onto the current occupied histogram bins, so the 32-bin spatial
// approximation and changing lit-chroma groups remain explicit limitations.
// Legacy selection has no retained RGB or RGB mixing. Region mode instead uses
// unlit albedo chromaticity for identity and transitions toward fresh solver targets.
// Neither mode silently clamps resource capacity.
//
// Supported input: one selected 16-bit subject, part IDs 0..4, <= 4,194,304 pixels,
// finite linear RGB in [0,16], positive finite eye depth. HDR is not clipped;
// adaptive L range preserves physical Oklab-L error units. Optional relative-L
// acceptance scales RMS/contrast limits by mean L with an independent black floor;
// it does not change the metric, observed RGB candidates or display coordinates.
// Opt-in Hair/Skin illumination modes take precedence and use
// native diffuse illumination Y instead, with error relative to mean received
// illumination (and a darkness floor). Target candidate RGB remains source-observed;
// a displayed region may be between its previous and target representative colors.
// Source and sparse
// seed textures must share dimensions, color encoding and original shading.
// _ToneOutput copies sparse source alpha (eye depth) and all other subjects.
// Meta is read-only. There is no alpha/color reconstruction at empty seeds.
//
// Status[0..159]: 1 READY, 2 broad guard present, 4 RMS failed, 8 contrast failed.
// Status[160]: 1 hash capacity, 2 dimensions, 4 RGB/depth, 8 part/chroma range,
// 16 settings, 32 sparse/native seed mismatch, 64 invalid native illumination.
// Any failure preserves original RGB;
// a retained original is explicitly NOT a successful tone result.
// Solutions[group*3+0] = (K, weighted metric RMSE, required contrast, actual contrast).
// Solutions[group*3+1] = (brightest base metric, accent metric, cutoff metric, enabled).
// The metric is Oklab L except for independently opted-in Hair/Skin illumination Y.
// Solutions[group*3+2].rgb = actual observed accent RGB.

#pragma kernel Clear
#pragma kernel GatherGroups
#pragma kernel GatherHistogram
#pragma kernel SolveTones
#pragma kernel GatherHighlights
#pragma kernel SolveHighlights
#pragma kernel UpdateRegions
#pragma kernel Resolve
#pragma kernel StoreHistory
#pragma target 5.0

#define TONE_GROUPS 160u
#define TONE_BINS 32u
#define TONE_TILES 16u
#define TONE_HISTORY_STRIDE 34u
#define TONE_REGION_STRIDE 197u
#define TONE_REGION_HEADER 8u
#define TONE_REGION_MAX 63u
#define TONE_PIXEL_MASK 4194303u
#define TONE_Q 65535.0
#define TONE_INF 3.402823466e+38

Texture2D<float4> _ToneSourceColor;
Texture2D<float4> _ToneSourceMeta;
Texture2D<float4> _ToneSourceLighting;
Texture2D<float4> _ToneCellColor;
Texture2D<float4> _ToneCellMeta;
RWTexture2D<float4> _ToneOutput;
RWStructuredBuffer<uint> _ToneGroups;
RWStructuredBuffer<uint> _ToneHistogram;
RWStructuredBuffer<uint> _ToneTiles;
RWStructuredBuffer<uint> _ToneTileHistogram;
RWStructuredBuffer<uint> _ToneSupports;
RWStructuredBuffer<uint> _ToneHighlightHistogram;
RWStructuredBuffer<uint> _ToneStatus;
RWStructuredBuffer<float4> _TonePalette;
RWStructuredBuffer<float4> _ToneSolutions;
StructuredBuffer<float4> _TonePreviousHistory;
RWStructuredBuffer<float4> _ToneNextHistory;
StructuredBuffer<float4> _TonePreviousRegions;
RWStructuredBuffer<float4> _ToneNextRegions;
StructuredBuffer<float4> _ToneDisplayRegions;

int _ToneWidth;
int _ToneHeight;
int _ToneSubjectId;
float _ToneError;
int _ToneRelativeLightness;
float _ToneLightnessRelativeError;
float _ToneLightnessBlackFloor;
float _ToneChromaError;
float _ToneContrastRetention;
float _ToneMinimumContrast;
float _ToneHighlightMinimumContrast;
int _ToneHairLightingEnabled;
float _ToneHairRelativeError;
float _ToneHairIlluminationFloor;
int _ToneSkinLightingEnabled;
float _ToneSkinRelativeError;
float _ToneSkinIlluminationFloor;
int _ToneHistoryValid;
int _ToneTemporalStability;
float _ToneShrinkMargin;
int _ToneRegionTransitions;
int _ToneRegionHistoryValid;
float _ToneRegionDeltaTime;
float _ToneRegionSeconds;

// Only integer atomics touch shared histograms. Carry increments commute even
// when another invocation adds to the low word before this carry is recorded.
#define TONE_ADD_PAIR(BUFFER, OFFSET, VALUE) { \
    uint toneOldWord; \
    InterlockedAdd(BUFFER[OFFSET], VALUE, toneOldWord); \
    if (toneOldWord > 0xffffffffu - (VALUE)) InterlockedAdd(BUFFER[(OFFSET) + 1u], 1u); \
}

float PairValue(uint lowWord, uint highWord)
{
    return (float)highWord * 4294967296.0 + (float)lowWord;
}

float3 LinearToOklab(float3 rgb)
{
    float3 lms = float3(
        dot(rgb, float3(.4122214708, .5363325363, .0514459929)),
        dot(rgb, float3(.2119034982, .6806995451, .1073969566)),
        dot(rgb, float3(.0883024619, .2817188376, .6299787005)));
    lms = pow(max(lms, 0.0), 1.0 / 3.0);
    return float3(
        dot(lms, float3(.2104542553, .7936177850, -.0040720468)),
        dot(lms, float3(1.9779984951, -2.4285922050, .4505937099)),
        dot(lms, float3(.0259040371, .7827717662, -.8086757660)));
}

uint Subject(float4 meta)
{
    return (uint)round(meta.r * 255.0) + ((uint)round(meta.a * 255.0) << 8u);
}

bool InBounds(uint2 pixel)
{
    return pixel.x < (uint)_ToneWidth && pixel.y < (uint)_ToneHeight;
}

bool ValidColorDepth(float4 value)
{
    return all(isfinite(value)) && all(value.rgb >= 0.0) &&
        all(value.rgb <= 16.0) && value.a > 0.0;
}

bool HairLightingPart(float4 meta)
{
    return _ToneHairLightingEnabled != 0 && (uint)round(meta.g * 255.0) == 3u;
}

bool HairLightingGroup(uint group)
{
    return _ToneHairLightingEnabled != 0 && (_ToneGroups[group * 8u] >> 16u) == 4u;
}

bool SkinLightingPart(float4 meta)
{
    return _ToneSkinLightingEnabled != 0 && (uint)round(meta.g * 255.0) == 4u;
}

bool SkinLightingGroup(uint group)
{
    return _ToneSkinLightingEnabled != 0 && (_ToneGroups[group * 8u] >> 16u) == 5u;
}

bool IlluminationGroup(uint group)
{
    return HairLightingGroup(group) || SkinLightingGroup(group);
}

bool RelativeLightnessGroup(uint group)
{
    return _ToneRelativeLightness != 0 && !IlluminationGroup(group);
}

// Native lighting and native RGB must describe the same visible opted-in surface.
// Resolve also calls this for sparse seeds; it reports a seed mismatch using
// bit 32 so one resolving pixel cannot change another pixel's decision.
bool TryAnalysisMetric(uint2 pixel, float3 lab, float4 meta, out float metric)
{
    metric = lab.x;
    if (!HairLightingPart(meta) && !SkinLightingPart(meta)) return true;
    float4 lighting = _ToneSourceLighting.Load(int3(pixel, 0));
    float4 nativeMeta = _ToneSourceMeta.Load(int3(pixel, 0));
    if (!all(isfinite(lighting)) || lighting.r < 0.0 || lighting.a != 1.0 ||
        Subject(nativeMeta) != Subject(meta) ||
        (uint)round(nativeMeta.g * 255.0) != (uint)round(meta.g * 255.0))
        return false;
    metric = lighting.r;
    return true;
}

float MetricScale(uint group, float2 range, float normalizedMean)
{
    if (HairLightingGroup(group))
        return max(range.x + range.y * normalizedMean, _ToneHairIlluminationFloor);
    if (SkinLightingGroup(group))
        return max(range.x + range.y * normalizedMean, _ToneSkinIlluminationFloor);
    if (RelativeLightnessGroup(group))
        return max(range.x + range.y * normalizedMean, _ToneLightnessBlackFloor);
    return 1.0;
}

uint HistoryMetricMode(uint group)
{
    if (HairLightingGroup(group)) return 1u;
    if (SkinLightingGroup(group)) return 2u;
    if (RelativeLightnessGroup(group)) return 3u;
    return 0u;
}

float HistoryMetricScale(uint group, float2 range, float normalizedMean)
{
    // Relative-L changes acceptance limits only. Preserve the existing history
    // coordinate units. Their shared current mean can still move unaffected
    // pixels across Resolve thresholds under partial lighting; this is not a
    // spatial/per-surface transition fix.
    // Keep the history floor independent from the acceptance-mode branches.
    float historyFloor = 1e-5;
    if (HairLightingGroup(group)) historyFloor = _ToneHairIlluminationFloor;
    else if (SkinLightingGroup(group)) historyFloor = _ToneSkinIlluminationFloor;
    return max(range.x + range.y * normalizedMean, historyFloor);
}

uint ColorKey(float3 lab, float4 meta, uint2 pixel)
{
    uint part = (uint)round(meta.g * 255.0);
    float2 chroma = lab.yz / max(lab.x, .05);
    bool valid = true;
    if (_ToneRegionTransitions != 0)
    {
        float4 identity = _ToneSourceLighting.Load(int3(pixel, 0));
        valid = all(isfinite(identity)) && identity.a == 1.0;
        chroma = valid ? identity.gb : float2(0, 0);
    }
    // Zero chroma sits at a cell center, not at a floating-point sign boundary.
    int2 cell = (int2)floor(chroma / (_ToneChromaError * .7071067811865475) + .5);
    uint key = 0u;
    if (valid && part <= 4u && all(cell >= -128) && all(cell <= 127))
        key = ((part + 1u) << 16u) | ((uint)(cell.x + 128) << 8u) | (uint)(cell.y + 128);
    return key;
}

uint FindGroup(uint key)
{
    uint slot = (key * 2654435761u) % TONE_GROUPS;
    [loop] for (uint probe = 0u; probe < TONE_GROUPS; ++probe)
    {
        uint stored = _ToneGroups[slot * 8u];
        if (stored == key) return slot;
        if (stored == 0u) return TONE_GROUPS;
        slot = (slot + 1u) % TONE_GROUPS;
    }
    return TONE_GROUPS;
}

float2 LightnessRange(uint group)
{
    float minimum = asfloat(_ToneGroups[group * 8u + 6u]);
    float maximum = asfloat(_ToneGroups[group * 8u + 7u]);
    return float2(minimum, max(maximum - minimum, 0.0));
}

float NormalizeL(float lightness, float2 range)
{
    return range.y > 1e-8 ? saturate((lightness - range.x) / range.y) : 0.0;
}

uint LightnessBin(float normalizedL)
{
    return min((uint)(normalizedL * TONE_BINS), TONE_BINS - 1u);
}

uint SpatialTile(uint2 pixel, uint group)
{
    uint2 origin = uint2(_ToneGroups[group * 8u + 2u], _ToneGroups[group * 8u + 3u]);
    uint2 maximum = uint2(_ToneGroups[group * 8u + 4u], _ToneGroups[group * 8u + 5u]);
    uint2 tile = min((pixel - origin) * 4u / (maximum - origin + 1u), 3u);
    return tile.y * 4u + tile.x;
}

float4 Candidate(uint group, uint bin)
{
    uint packed = _ToneHistogram[(group * TONE_BINS + bin) * 6u + 5u];
    uint index = packed & TONE_PIXEL_MASK;
    int3 pixel = int3(index % (uint)_ToneWidth, index / (uint)_ToneWidth, 0);
    float3 rgb = _ToneSourceColor.Load(pixel).rgb;
    float metric = IlluminationGroup(group) ? _ToneSourceLighting.Load(pixel).r : LinearToOklab(rgb).x;
    return float4(rgb, metric);
}

[numthreads(64, 1, 1)]
void Clear(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < TONE_GROUPS * 8u)
    {
        uint field = index % 8u;
        _ToneGroups[index] = field == 2u || field == 3u || field == 6u ? 0xffffffffu : 0u;
    }
    if (index < TONE_GROUPS * TONE_BINS * 6u)
        _ToneHistogram[index] = index % 6u == 5u ? 0xffffffffu : 0u;
    if (index < TONE_GROUPS * TONE_TILES * 3u) _ToneTiles[index] = 0u;
    if (index < TONE_GROUPS * TONE_TILES * TONE_BINS) _ToneTileHistogram[index] = 0u;
    if (index < TONE_GROUPS * 2u) _ToneSupports[index] = 0u;
    if (index < TONE_GROUPS * TONE_BINS * 5u) _ToneHighlightHistogram[index] = 0u;
    // Palette/Solutions initialize in SolveTones: keeping Clear to seven UAVs
    // avoids exceeding the D3D11 eight-UAV binding limit.
    if (index < TONE_GROUPS) _ToneStatus[index] = 0u;
    if (index == TONE_GROUPS)
    {
        uint status = 0u;
        if (_ToneWidth <= 0 || _ToneHeight <= 0 || _ToneWidth > 4194304 ||
            _ToneHeight > 4194304 || (uint)_ToneWidth > 4194304u / max((uint)_ToneHeight, 1u)) status |= 2u;
        if (_ToneSubjectId <= 0 || _ToneSubjectId > 65535 ||
            !isfinite(_ToneError) || _ToneError <= 0.0 || _ToneError > 1.0 ||
            !isfinite(_ToneChromaError) || _ToneChromaError < .005 || _ToneChromaError > 1.0 ||
            !isfinite(_ToneContrastRetention) || _ToneContrastRetention <= 0.0 || _ToneContrastRetention > 1.0 ||
            !isfinite(_ToneMinimumContrast) || _ToneMinimumContrast <= 0.0 || _ToneMinimumContrast > 1.0 ||
            !isfinite(_ToneHighlightMinimumContrast) || _ToneHighlightMinimumContrast <= 0.0 || _ToneHighlightMinimumContrast > 1.0)
            status |= 16u;
        if (_ToneRelativeLightness != 0 &&
            (!isfinite(_ToneLightnessRelativeError) || _ToneLightnessRelativeError <= 0.0 || _ToneLightnessRelativeError > 1.0 ||
             !isfinite(_ToneLightnessBlackFloor) || _ToneLightnessBlackFloor <= 0.0 || _ToneLightnessBlackFloor > 1.0))
            status |= 16u;
        if (_ToneHairLightingEnabled != 0 &&
            (!isfinite(_ToneHairRelativeError) || _ToneHairRelativeError <= 0.0 || _ToneHairRelativeError > 1.0 ||
             !isfinite(_ToneHairIlluminationFloor) || _ToneHairIlluminationFloor <= 0.0))
            status |= 16u;
        if (_ToneSkinLightingEnabled != 0 &&
            (!isfinite(_ToneSkinRelativeError) || _ToneSkinRelativeError <= 0.0 || _ToneSkinRelativeError > 1.0 ||
             !isfinite(_ToneSkinIlluminationFloor) || _ToneSkinIlluminationFloor <= 0.0))
            status |= 16u;
        if (_ToneTemporalStability != 0 &&
            (!isfinite(_ToneShrinkMargin) || _ToneShrinkMargin < 0.0 || _ToneShrinkMargin >= 1.0))
            status |= 16u;
        _ToneStatus[TONE_GROUPS] = status;
    }
}

[numthreads(8, 8, 1)]
void GatherGroups(uint3 id : SV_DispatchThreadID)
{
    if (!InBounds(id.xy) || (_ToneStatus[TONE_GROUPS] & 18u) != 0u) return;
    float4 meta = _ToneSourceMeta.Load(int3(id.xy, 0));
    if (Subject(meta) != (uint)_ToneSubjectId) return;
    float4 source = _ToneSourceColor.Load(int3(id.xy, 0));
    if (!ValidColorDepth(source)) { InterlockedOr(_ToneStatus[TONE_GROUPS], 4u); return; }
    float3 lab = LinearToOklab(source.rgb);
    float metric;
    if (!TryAnalysisMetric(id.xy, lab, meta, metric))
    { InterlockedOr(_ToneStatus[TONE_GROUPS], 64u); return; }
    uint key = ColorKey(lab, meta, id.xy);
    if (key == 0u) { InterlockedOr(_ToneStatus[TONE_GROUPS], 8u); return; }
    uint slot = (key * 2654435761u) % TONE_GROUPS;
    [loop] for (uint probe = 0u; probe < TONE_GROUPS; ++probe)
    {
        uint previous;
        InterlockedCompareExchange(_ToneGroups[slot * 8u], 0u, key, previous);
        if (previous == 0u || previous == key)
        {
            InterlockedAdd(_ToneGroups[slot * 8u + 1u], 1u);
            InterlockedMin(_ToneGroups[slot * 8u + 2u], id.x);
            InterlockedMin(_ToneGroups[slot * 8u + 3u], id.y);
            InterlockedMax(_ToneGroups[slot * 8u + 4u], id.x);
            InterlockedMax(_ToneGroups[slot * 8u + 5u], id.y);
            InterlockedMin(_ToneGroups[slot * 8u + 6u], asuint(max(metric, 0.0)));
            InterlockedMax(_ToneGroups[slot * 8u + 7u], asuint(max(metric, 0.0)));
            return;
        }
        slot = (slot + 1u) % TONE_GROUPS;
    }
    InterlockedOr(_ToneStatus[TONE_GROUPS], 1u);
}

[numthreads(8, 8, 1)]
void GatherHistogram(uint3 id : SV_DispatchThreadID)
{
    if (!InBounds(id.xy) || _ToneStatus[TONE_GROUPS] != 0u) return;
    float4 meta = _ToneSourceMeta.Load(int3(id.xy, 0));
    if (Subject(meta) != (uint)_ToneSubjectId) return;
    float3 lab = LinearToOklab(_ToneSourceColor.Load(int3(id.xy, 0)).rgb);
    float metric;
    if (!TryAnalysisMetric(id.xy, lab, meta, metric)) return;
    uint group = FindGroup(ColorKey(lab, meta, id.xy));
    if (group >= TONE_GROUPS) return;
    float u = NormalizeL(metric, LightnessRange(group));
    uint bin = LightnessBin(u);
    uint q = (uint)round(u * TONE_Q);
    uint base = (group * TONE_BINS + bin) * 6u;
    InterlockedAdd(_ToneHistogram[base], 1u);
    TONE_ADD_PAIR(_ToneHistogram, base + 1u, q);
    TONE_ADD_PAIR(_ToneHistogram, base + 3u, q * q);
    uint distance = min((uint)round(abs(u * TONE_BINS - ((float)bin + .5)) * 1023.0), 1023u);
    uint candidate = (distance << 22u) | (id.y * (uint)_ToneWidth + id.x);
    InterlockedMin(_ToneHistogram[base + 5u], candidate);
    uint tile = SpatialTile(id.xy, group);
    uint tileBase = (group * TONE_TILES + tile) * 3u;
    InterlockedAdd(_ToneTiles[tileBase], 1u);
    TONE_ADD_PAIR(_ToneTiles, tileBase + 1u, q);
    InterlockedAdd(_ToneTileHistogram[(group * TONE_TILES + tile) * TONE_BINS + bin], 1u);
}

groupshared uint sCount[32];
groupshared float sSum[32];
groupshared float sSquare[32];
groupshared float4 sCandidate[32];
groupshared uint sActive[32];
groupshared uint sActiveCount;
groupshared float sWeightPrefix[33];
groupshared float sSumPrefix[33];
groupshared float sSquarePrefix[33];
groupshared float sCost[1024];
groupshared uint sCostRepresentative[1024];
groupshared uint sBack[1089];
groupshared float sPrevious[33];
groupshared float sCurrent[33];
groupshared uint sMap[32];
groupshared float sCoefficient[32];
groupshared uint sLowMask;
groupshared uint sHighMask;
groupshared float sRequired;
groupshared float sRetained;
groupshared float sRmse;
groupshared uint sReady;
groupshared uint sSelectedK;
groupshared float sErrorLimit;
groupshared uint sHistoryMap[32];
groupshared uint sHistoryAddress;
groupshared uint sHistoryCount;
groupshared uint sHistoryReady;
groupshared float sHistoryScale;
groupshared float sHistoryRmse;
groupshared float sHistoryRetained;

// Means use occupied tiles only; moments/coherence still weight actual pixels.
// These tile quantiles are an explicit approximation to source-pixel quantiles.
void TileMasks(float means[16], uint counts[16], uint size,
    out uint lowMask, out uint highMask)
{
    float sorted[16];
    uint used = 0u;
    [fastopt] [loop] for (uint i = 0u; i < 16u; ++i)
    {
        bool occupied = i < size && counts[i] > 0u;
        sorted[i] = occupied ? means[i] : TONE_INF;
        if (occupied) ++used;
    }
    // Fixed bounds avoid an FXC diagnostic on a data-dependent insertion loop.
    [fastopt] [loop] for (uint sortPass = 0u; sortPass < 15u; ++sortPass)
    {
        [fastopt] [loop] for (uint j = 0u; j < 15u; ++j)
        {
            float left = sorted[j];
            float right = sorted[j + 1u];
            sorted[j] = min(left, right);
            sorted[j + 1u] = max(left, right);
        }
    }
    lowMask = highMask = 0u;
    if (used < 2u) return;
    float lowPosition = (used - 1u) * .2;
    float highPosition = (used - 1u) * .8;
    float low = lerp(sorted[(uint)floor(lowPosition)], sorted[(uint)ceil(lowPosition)], frac(lowPosition));
    float high = lerp(sorted[(uint)floor(highPosition)], sorted[(uint)ceil(highPosition)], frac(highPosition));
    if (high - low <= 1e-8) return;
    [fastopt] [loop] for (uint j = 0u; j < size; ++j)
    {
        if (counts[j] == 0u) continue;
        if (means[j] <= low) lowMask |= 1u << j;
        if (means[j] >= high) highMask |= 1u << j;
    }
}

void BuildBroadSupport(uint group, float2 range, float minimumContrast)
{
    sLowMask = sHighMask = 0u;
    sRequired = 0.0;
    float count = sWeightPrefix[sActiveCount];
    float mean = sSumPrefix[sActiveCount] / count;
    float variance = max(sSquarePrefix[sActiveCount] / count - mean * mean, 0.0);
    if (variance <= 1e-12 || range.y < minimumContrast) return;
    uint counts[16];
    float sums[16];
    float means[16];
    uint coarseCounts[16];
    float coarseSums[16];
    float coarseMeans[16];
    [fastopt] [loop] for (uint reset = 0u; reset < 16u; ++reset)
    {
        coarseCounts[reset] = 0u;
        coarseSums[reset] = coarseMeans[reset] = 0.0;
    }
    float fineVariance = 0.0;
    [fastopt] [loop] for (uint tile = 0u; tile < 16u; ++tile)
    {
        uint base = (group * TONE_TILES + tile) * 3u;
        counts[tile] = _ToneTiles[base];
        sums[tile] = PairValue(_ToneTiles[base + 1u], _ToneTiles[base + 2u]) / TONE_Q;
        means[tile] = counts[tile] > 0u ? sums[tile] / counts[tile] : 0.0;
        fineVariance += counts[tile] * (means[tile] - mean) * (means[tile] - mean);
        uint coarse = (tile / 8u) * 2u + (tile % 4u) / 2u;
        coarseCounts[coarse] += counts[tile];
        coarseSums[coarse] += sums[tile];
    }
    float coarseVariance = 0.0;
    [unroll] for (uint cell = 0u; cell < 4u; ++cell)
    {
        coarseMeans[cell] = coarseCounts[cell] > 0u ? coarseSums[cell] / coarseCounts[cell] : 0.0;
        coarseVariance += coarseCounts[cell] * (coarseMeans[cell] - mean) * (coarseMeans[cell] - mean);
    }
    if (fineVariance / (count * variance) < .35 || coarseVariance / (count * variance) < .35) return;
    uint fineLow, fineHigh, coarseLow, coarseHigh;
    TileMasks(means, counts, 16u, fineLow, fineHigh);
    TileMasks(coarseMeans, coarseCounts, 4u, coarseLow, coarseHigh);
    if (fineLow == 0u || fineHigh == 0u || coarseLow == 0u || coarseHigh == 0u) return;
    float fineLowCount = 0.0, fineHighCount = 0.0, lowCount = 0.0, highCount = 0.0;
    float lowOverlap = 0.0, highOverlap = 0.0, lowSum = 0.0, highSum = 0.0;
    uint lowMask = 0u, highMask = 0u;
    [fastopt] [loop] for (uint t = 0u; t < 16u; ++t)
    {
        uint bit = 1u << t;
        uint coarseBit = 1u << ((t / 8u) * 2u + (t % 4u) / 2u);
        if ((fineLow & bit) != 0u) fineLowCount += counts[t];
        if ((fineHigh & bit) != 0u) fineHighCount += counts[t];
        if ((coarseLow & coarseBit) != 0u)
        {
            lowMask |= bit; lowCount += counts[t]; lowSum += sums[t];
            if ((fineLow & bit) != 0u) lowOverlap += counts[t];
        }
        if ((coarseHigh & coarseBit) != 0u)
        {
            highMask |= bit; highCount += counts[t]; highSum += sums[t];
            if ((fineHigh & bit) != 0u) highOverlap += counts[t];
        }
    }
    if (min(lowCount, highCount) <= 0.0 || min(fineLowCount, fineHighCount) <= 0.0 ||
        lowOverlap / min(fineLowCount, lowCount) < .65 ||
        highOverlap / min(fineHighCount, highCount) < .65) return;
    float contrast = range.y * (highSum / highCount - lowSum / lowCount);
    if (contrast < minimumContrast) return;
    sLowMask = lowMask;
    sHighMask = highMask;
    sRequired = contrast * _ToneContrastRetention;
}

uint FindHistory(uint group)
{
    if (_ToneTemporalStability == 0 || _ToneHistoryValid == 0) return TONE_GROUPS;
    uint key = _ToneGroups[group * 8u];
    uint mode = HistoryMetricMode(group);
    // Concurrent hash insertion can move a ColorKey to another slot each frame.
    [fastopt] [loop] for (uint slot = 0u; slot < TONE_GROUPS; ++slot)
    {
        uint address = slot * TONE_HISTORY_STRIDE;
        float4 header = _TonePreviousHistory[address];
        if (header.w != 1.0 || asuint(header.x) != key || header.z != (float)mode) continue;
        if (!isfinite(header.y) || header.y < 1.0 || header.y > (float)TONE_BINS || floor(header.y) != header.y)
            return TONE_GROUPS;
        float4 domain = _TonePreviousHistory[address + 1u];
        if (!all(isfinite(domain)) || domain.x <= 0.0) return TONE_GROUPS;
        float previousUpper = -1.0;
        [fastopt] [loop] for (uint entry = 0u; entry < (uint)header.y; ++entry)
        {
            float4 interval = _TonePreviousHistory[address + 2u + entry];
            if (!all(isfinite(interval.xy)) || interval.x < previousUpper || interval.y < 0.0)
                return TONE_GROUPS;
            previousUpper = interval.x;
        }
        return slot;
    }
    return TONE_GROUPS;
}

// Called by lane zero after interval costs and support coefficients are ready.
// Historical boundaries are in metric / current mean scale, not old bin IDs.
// The existing solver assigns whole histogram bins, so each current bin's true
// normalized mean determines its interval; its full moments still count in RMS.
// Empty intervals vanish. No minimum K or historical RGB is introduced.
bool FitHistoryPartition(float2 range, bool preserveRepresentativeRole)
{
    uint previousCount = (uint)_TonePreviousHistory[sHistoryAddress].y;
    uint cursor = 0u;
    uint occupiedIntervals = 0u;
    float totalCost = 0.0;
    float retained = 0.0;
    [fastopt] [loop] for (uint interval = 0u; interval < previousCount; ++interval)
    {
        float2 role = _TonePreviousHistory[sHistoryAddress + 2u + interval].xy;
        uint start = cursor;
        [fastopt] [loop] while (cursor < sActiveCount)
        {
            uint bin = sActive[cursor];
            float binMetric = range.x + range.y * (sSum[bin] / sCount[bin]);
            if (interval + 1u < previousCount && binMetric / sHistoryScale > role.x) break;
            ++cursor;
        }
        if (cursor == start) continue;
        uint representative = sCostRepresentative[start * TONE_BINS + cursor - 1u];
        if (preserveRepresentativeRole)
        {
            float closest = TONE_INF;
            [fastopt] [loop] for (uint candidate = start; candidate < cursor; ++candidate)
            {
                uint bin = sActive[candidate];
                float distance = abs(sCandidate[bin].a / sHistoryScale - role.y);
                if (distance < closest) { closest = distance; representative = bin; }
            }
        }
        float weight = sWeightPrefix[cursor] - sWeightPrefix[start];
        float sum = sSumPrefix[cursor] - sSumPrefix[start];
        float square = sSquarePrefix[cursor] - sSquarePrefix[start];
        float r = NormalizeL(sCandidate[representative].a, range);
        totalCost += max(square - 2.0 * r * sum + r * r * weight, 0.0);
        [fastopt] [loop] for (uint n = start; n < cursor; ++n)
        {
            uint bin = sActive[n];
            sHistoryMap[bin] = representative;
            retained += sCoefficient[bin] * sCandidate[representative].a;
        }
        ++occupiedIntervals;
    }
    sHistoryCount = occupiedIntervals;
    sHistoryRmse = range.y * sqrt(totalCost / sWeightPrefix[sActiveCount]);
    sHistoryRetained = retained;
    // History is held to the actual error limit. The legacy DP's 1e-6 arithmetic
    // tolerance is not expanded into a temporal permission to exceed the limit.
    return cursor == sActiveCount && occupiedIntervals > 0u &&
        sHistoryRmse <= sErrorLimit && retained + 1e-6 >= sRequired;
}

[numthreads(32, 1, 1)]
void SolveTones(uint3 workgroup : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint group = workgroup.x;
    if (group >= TONE_GROUPS) return;
    // Each address has one initialization writer and the same eventual writer.
    // Negative L is an empty-bin marker; L=0 is a valid observed black color.
    _TonePalette[group * TONE_BINS + lane] = float4(0.0, 0.0, 0.0, -1.0);
    if (lane == 0u)
    {
        _ToneSolutions[group * 3u] = 0.0;
        _ToneSolutions[group * 3u + 1u] = 0.0;
        _ToneSolutions[group * 3u + 2u] = 0.0;
    }
    bool enabled = _ToneStatus[TONE_GROUPS] == 0u && _ToneGroups[group * 8u] != 0u;
    uint base = (group * TONE_BINS + lane) * 6u;
    sCount[lane] = enabled ? _ToneHistogram[base] : 0u;
    sSum[lane] = enabled ? PairValue(_ToneHistogram[base + 1u], _ToneHistogram[base + 2u]) / TONE_Q : 0.0;
    sSquare[lane] = enabled ? PairValue(_ToneHistogram[base + 3u], _ToneHistogram[base + 4u]) / (TONE_Q * TONE_Q) : 0.0;
    sCandidate[lane] = 0.0;
    if (sCount[lane] > 0u) sCandidate[lane] = Candidate(group, lane);
    sMap[lane] = 0u;
    sPrevious[lane] = TONE_INF;
    float2 range = 0.0;
    if (enabled) range = LightnessRange(group);
    GroupMemoryBarrierWithGroupSync();
    if (lane == 0u)
    {
        sActiveCount = 0u;
        sWeightPrefix[0] = sSumPrefix[0] = sSquarePrefix[0] = 0.0;
        [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
        {
            if (sCount[b] == 0u) continue;
            uint end = ++sActiveCount;
            sActive[end - 1u] = b;
            sWeightPrefix[end] = sWeightPrefix[end - 1u] + sCount[b];
            sSumPrefix[end] = sSumPrefix[end - 1u] + sSum[b];
            sSquarePrefix[end] = sSquarePrefix[end - 1u] + sSquare[b];
        }
        sPrevious[0] = 0.0;
        sPrevious[32] = TONE_INF;
        sReady = sSelectedK = 0u;
        sRmse = sRetained = 0.0;
        sLowMask = sHighMask = 0u;
        sRequired = 0.0;
        sErrorLimit = _ToneError;
        sHistoryReady = sHistoryCount = 0u;
        sHistoryAddress = 0u;
        sHistoryScale = 1.0;
        sHistoryRmse = sHistoryRetained = 0.0;
        if (sActiveCount > 0u)
        {
            sHistoryScale = HistoryMetricScale(group, range,
                sSumPrefix[sActiveCount] / sWeightPrefix[sActiveCount]);
            float scale = MetricScale(group, range,
                sSumPrefix[sActiveCount] / sWeightPrefix[sActiveCount]);
            if (HairLightingGroup(group)) sErrorLimit = scale * _ToneHairRelativeError;
            else if (SkinLightingGroup(group)) sErrorLimit = scale * _ToneSkinRelativeError;
            else if (RelativeLightnessGroup(group)) sErrorLimit = scale * _ToneLightnessRelativeError;
            BuildBroadSupport(group, range, _ToneMinimumContrast * scale);
        }
        _ToneSupports[group * 2u] = sLowMask;
        _ToneSupports[group * 2u + 1u] = sHighMask;
    }
    GroupMemoryBarrierWithGroupSync();
    // Fixed support histograms evaluate any palette without refitting supports.
    float lowCount = 0.0, highCount = 0.0, lowBin = 0.0, highBin = 0.0;
    [fastopt] [loop] for (uint tile = 0u; tile < TONE_TILES; ++tile)
    {
        uint count = _ToneTiles[(group * TONE_TILES + tile) * 3u];
        uint binCount = _ToneTileHistogram[(group * TONE_TILES + tile) * TONE_BINS + lane];
        if ((sLowMask & (1u << tile)) != 0u) { lowCount += count; lowBin += binCount; }
        if ((sHighMask & (1u << tile)) != 0u) { highCount += count; highBin += binCount; }
    }
    sCoefficient[lane] = sRequired > 0.0 ? highBin / highCount - lowBin / lowCount : 0.0;
    if (lane < sActiveCount)
    {
        [fastopt] [loop] for (uint end = lane; end < sActiveCount; ++end)
        {
            float weight = sWeightPrefix[end + 1u] - sWeightPrefix[lane];
            float sum = sSumPrefix[end + 1u] - sSumPrefix[lane];
            float square = sSquarePrefix[end + 1u] - sSquarePrefix[lane];
            float mean = sum / weight;
            uint representative = sActive[lane];
            float bestDistance = TONE_INF;
            [fastopt] [loop] for (uint candidate = lane; candidate <= end; ++candidate)
            {
                uint b = sActive[candidate];
                float distance = abs(NormalizeL(sCandidate[b].a, range) - mean);
                if (distance < bestDistance) { bestDistance = distance; representative = b; }
            }
            float r = NormalizeL(sCandidate[representative].a, range);
            // A one-bin interval still contains source variation; never force
            // its error to zero merely because the histogram has one bin.
            sCost[lane * TONE_BINS + end] = max(square - 2.0 * r * sum + r * r * weight, 0.0);
            sCostRepresentative[lane * TONE_BINS + end] = representative;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    if (lane == 0u && sActiveCount > 0u)
    {
        uint previousSlot = FindHistory(group);
        if (previousSlot < TONE_GROUPS)
        {
            sHistoryAddress = previousSlot * TONE_HISTORY_STRIDE;
            // First keep the previous tone's relative role using a CURRENT
            // observed candidate. If it no longer fits, refit the same partition
            // to current SSE-optimal candidates before abandoning its boundaries.
            bool fits = FitHistoryPartition(range, true);
            if (!fits) fits = FitHistoryPartition(range, false);
            sHistoryReady = fits ? 1u : 0u;
        }
    }
    GroupMemoryBarrierWithGroupSync();
    // Every lane reaches the same 32 barrier rounds, including inactive groups
    // and already accepted candidates. UAV/shared-memory predicates must not
    // control a barrier loop or an early return on D3D11/FXC.
    [fastopt] [loop] for (uint k = 1u; k <= TONE_BINS; ++k)
    {
        uint end = lane + 1u;
        float best = TONE_INF;
        uint bestStart = 0u;
        if (sReady == 0u && (sHistoryReady == 0u || k < sHistoryCount) &&
            end >= k && end <= sActiveCount)
        {
            [fastopt] [loop] for (uint start = k - 1u; start < end; ++start)
            {
                float candidate = sPrevious[start] + sCost[start * TONE_BINS + end - 1u];
                if (candidate < best) { best = candidate; bestStart = start; }
            }
        }
        sCurrent[end] = best;
        sBack[k * 33u + end] = bestStart;
        GroupMemoryBarrierWithGroupSync();
        if (lane == 0u)
        {
            sCurrent[0] = TONE_INF;
            if (sReady == 0u && sHistoryReady != 0u && k >= sHistoryCount)
            {
                [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
                    if (sCount[b] > 0u) sMap[b] = sHistoryMap[b];
                sRmse = sHistoryRmse;
                sRetained = sHistoryRetained;
                sSelectedK = sHistoryCount;
                sReady = 1u;
            }
            else if (sReady == 0u && k <= sActiveCount)
            {
                sRmse = range.y * sqrt(max(sCurrent[sActiveCount], 0.0) / sWeightPrefix[sActiveCount]);
                float selectionLimit = sHistoryReady != 0u ?
                    sErrorLimit * (1.0 - _ToneShrinkMargin) : sErrorLimit;
                float roundoff = sHistoryReady != 0u ? 0.0 : 1e-6;
                if (sRmse <= selectionLimit + roundoff)
                {
                    uint cursor = sActiveCount;
                    [fastopt] [loop] for (uint level = k; level > 0u; --level)
                    {
                        uint start = sBack[level * 33u + cursor];
                        uint representative = sCostRepresentative[start * TONE_BINS + cursor - 1u];
                        [fastopt] [loop] for (uint n = start; n < cursor; ++n) sMap[sActive[n]] = representative;
                        cursor = start;
                    }
                    sRetained = 0.0;
                    [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
                        if (sCount[b] > 0u) sRetained += sCoefficient[b] * sCandidate[sMap[b]].a;
                    if (sRetained + 1e-6 >= sRequired) { sReady = 1u; sSelectedK = k; }
                }
            }
        }
        GroupMemoryBarrierWithGroupSync();
        sPrevious[lane + 1u] = sCurrent[lane + 1u];
        if (lane == 0u) sPrevious[0] = TONE_INF;
        GroupMemoryBarrierWithGroupSync();
    }
    if (sReady != 0u && sCount[lane] > 0u) _TonePalette[group * TONE_BINS + lane] = sCandidate[sMap[lane]];
    if (lane == 0u && enabled)
    {
        uint status = sRequired > 0.0 ? 2u : 0u;
        status |= sReady != 0u ? 1u : (sRmse > sErrorLimit + 1e-6 ? 4u : 8u);
        _ToneStatus[group] = status;
        _ToneSolutions[group * 3u] = float4(sSelectedK, sRmse, sRequired, sRetained);
        float brightest = 0.0;
        if (sReady != 0u)
        {
            [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
                if (sCount[b] > 0u) brightest = max(brightest, sCandidate[sMap[b]].a);
        }
        _ToneSolutions[group * 3u + 1u] = float4(brightest, 0.0, 0.0, 0.0);
    }
}

[numthreads(8, 8, 1)]
void GatherHighlights(uint3 id : SV_DispatchThreadID)
{
    if (!InBounds(id.xy) || _ToneStatus[TONE_GROUPS] != 0u) return;
    float4 meta = _ToneSourceMeta.Load(int3(id.xy, 0));
    if (Subject(meta) != (uint)_ToneSubjectId) return;
    float3 lab = LinearToOklab(_ToneSourceColor.Load(int3(id.xy, 0)).rgb);
    float lightness;
    if (!TryAnalysisMetric(id.xy, lab, meta, lightness)) return;
    uint group = FindGroup(ColorKey(lab, meta, id.xy));
    if (group >= TONE_GROUPS || (_ToneStatus[group] & 3u) != 3u) return;
    uint tile = SpatialTile(id.xy, group);
    if ((_ToneSupports[group * 2u + 1u] & (1u << tile)) == 0u) return;
    float u = NormalizeL(lightness, LightnessRange(group));
    uint bin = LightnessBin(u);
    if (_TonePalette[group * TONE_BINS + bin].a != _ToneSolutions[group * 3u + 1u].x) return;
    uint q = (uint)round(u * TONE_Q);
    uint base = (group * TONE_BINS + bin) * 5u;
    InterlockedAdd(_ToneHighlightHistogram[base], 1u);
    TONE_ADD_PAIR(_ToneHighlightHistogram, base + 1u, q);
    TONE_ADD_PAIR(_ToneHighlightHistogram, base + 3u, q * q);
}

[numthreads(32, 1, 1)]
void SolveHighlights(uint3 workgroup : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint group = workgroup.x;
    if (group >= TONE_GROUPS) return;
    bool enabled = _ToneStatus[TONE_GROUPS] == 0u && (_ToneStatus[group] & 3u) == 3u;
    sCount[lane] = enabled ? _ToneHistogram[(group * TONE_BINS + lane) * 6u] : 0u;
    sSum[lane] = enabled && (IlluminationGroup(group) || RelativeLightnessGroup(group)) ?
        PairValue(_ToneHistogram[(group * TONE_BINS + lane) * 6u + 1u],
            _ToneHistogram[(group * TONE_BINS + lane) * 6u + 2u]) / TONE_Q : 0.0;
    sCandidate[lane] = 0.0;
    if (sCount[lane] > 0u) sCandidate[lane] = Candidate(group, lane);
    GroupMemoryBarrierWithGroupSync();
    if (lane != 0u || !enabled) return;
    float2 range = LightnessRange(group);
    if (range.y <= 1e-8) return;
    float minimumContrast = _ToneHighlightMinimumContrast;
    if (IlluminationGroup(group) || RelativeLightnessGroup(group))
    {
        float count = 0.0, sum = 0.0;
        [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
        { count += sCount[b]; sum += sSum[b]; }
        minimumContrast *= MetricScale(group, range, sum / count);
    }
    float baseL = _ToneSolutions[group * 3u + 1u].x;
    float baseU = NormalizeL(baseL, range);
    float bestGain = 1e-9;
    float4 accent = 0.0;
    float cutoff = 0.0;
    float tailCount = 0.0, tailSum = 0.0;
    // Tail boundaries are histogram boundaries: a conservative subset of the
    // Python observed-L tails. The final resolve also checks each actual pixel.
    [fastopt] [loop] for (int start = 31; start >= 0; --start)
    {
        uint address = (group * TONE_BINS + (uint)start) * 5u;
        tailCount += _ToneHighlightHistogram[address];
        tailSum += PairValue(_ToneHighlightHistogram[address + 1u], _ToneHighlightHistogram[address + 2u]) / TONE_Q;
        if (tailCount == 0.0) continue;
        float lower = (float)start / TONE_BINS;
        [fastopt] [loop] for (uint candidate = 0u; candidate < TONE_BINS; ++candidate)
        {
            if (sCount[candidate] == 0u) continue;
            float4 value = sCandidate[candidate];
            if (value.a < baseL + minimumContrast) continue;
            float u = NormalizeL(value.a, range);
            if (u > 2.0 * lower - baseU + 1e-7) continue;
            float gain = range.y * range.y *
                (2.0 * (u - baseU) * tailSum + (baseU * baseU - u * u) * tailCount);
            if (gain > bestGain) { bestGain = gain; accent = value; cutoff = range.x + lower * range.y; }
        }
    }
    if (accent.a > baseL)
    {
        _ToneSolutions[group * 3u + 1u] = float4(baseL, accent.a, cutoff, 1.0);
        _ToneSolutions[group * 3u + 2u] = float4(accent.rgb, bestGain);
    }
}

// Persistent ordered iso-regions, NOT a previous screen image. The current
// solver proposes colors/thresholds; only this stage advances displayed state.
// An interval is a level set of current surface illumination (or Oklab L), so
// it follows the rendered surface instead of being glued to camera pixels.
// This does not temporally filter the per-surface light field itself: sharp
// input/disocclusion changes remain a separate, explicitly unclaimed problem.
groupshared float rTargetUpper[32];
groupshared float4 rTargetColor[32];
groupshared float rUpper[63];
groupshared float rGoalUpper[63];
groupshared float4 rColor[63];
groupshared float4 rGoalColor[63];
groupshared uint rGoalIndex[63];

uint FindRegionHistory(uint key, uint mode)
{
    if (_ToneRegionHistoryValid == 0) return TONE_GROUPS;
    [loop] for (uint slot = 0u; slot < TONE_GROUPS; ++slot)
    {
        uint address = slot * TONE_REGION_STRIDE;
        float4 h = _TonePreviousRegions[address];
        float4 info = _TonePreviousRegions[address + 1u];
        if (asuint(h.x) == key && info.x == 1.0 && (uint)info.y == mode &&
            h.y >= 1.0 && h.y <= (float)TONE_REGION_MAX && h.z >= 1.0 && h.z <= (float)TONE_BINS)
            return slot;
    }
    return TONE_GROUPS;
}

[numthreads(32, 1, 1)]
void UpdateRegions(uint3 workgroup : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint group = workgroup.x;
    if (group >= TONE_GROUPS || lane != 0u) return;
    uint address = group * TONE_REGION_STRIDE;
    [loop] for (uint z = 0u; z < TONE_REGION_STRIDE; ++z) _ToneNextRegions[address + z] = 0.0;
    if (_ToneRegionTransitions == 0 || _ToneStatus[TONE_GROUPS] != 0u ||
        (_ToneStatus[group] & 1u) == 0u) return;
    if (!isfinite(_ToneRegionDeltaTime) || _ToneRegionDeltaTime < 0.0 ||
        !isfinite(_ToneRegionSeconds) || _ToneRegionSeconds <= 0.0)
    { InterlockedOr(_ToneStatus[TONE_GROUPS], 16u); return; }

    float2 range = LightnessRange(group);
    float count = 0.0, sum = 0.0;
    [loop] for (uint momentBin = 0u; momentBin < TONE_BINS; ++momentBin)
    {
        uint h = (group * TONE_BINS + momentBin) * 6u;
        count += _ToneHistogram[h];
        sum += PairValue(_ToneHistogram[h + 1u], _ToneHistogram[h + 2u]) / TONE_Q;
    }
    if (count <= 0.0) return;
    float scale = HistoryMetricScale(group, range, sum / count);
    float maximum = (range.x + range.y) / scale;
    uint targetCount = 0u, lastBin = 0u;
    float4 previous = float4(0, 0, 0, -1);
    [loop] for (uint targetBin = 0u; targetBin < TONE_BINS; ++targetBin)
    {
        if (_ToneHistogram[(group * TONE_BINS + targetBin) * 6u] == 0u) continue;
        float4 value = _TonePalette[group * TONE_BINS + targetBin];
        if (value.a < 0.0 || !all(isfinite(value))) return;
        if (previous.a >= 0.0 && any(value != previous))
        {
            rTargetUpper[targetCount] = (range.x +
                (float)(lastBin + 1u + targetBin) * .5 / TONE_BINS * range.y) / scale;
            rTargetColor[targetCount++] = previous;
        }
        previous = value;
        lastBin = targetBin;
    }
    if (previous.a < 0.0) return;
    rTargetUpper[targetCount] = TONE_INF;
    rTargetColor[targetCount++] = previous;

    uint oldSlot = FindRegionHistory(_ToneGroups[group * 8u], HistoryMetricMode(group));
    bool hasHistory = oldSlot < TONE_GROUPS;
    uint oldAddress = hasHistory ? oldSlot * TONE_REGION_STRIDE : 0u;
    float4 oldHeader = hasHistory ? _TonePreviousRegions[oldAddress] : 0.0;
    float4 oldInfo = hasHistory ? _TonePreviousRegions[oldAddress + 1u] : 0.0;
    float dt = _ToneRegionDeltaTime;
    float response = 1.0 - exp(-dt / _ToneRegionSeconds);
    uint regions = targetCount, goalCount = targetCount;
    float remaining = 0.0;
    // Both target thresholds and CURRENT surface metrics use CURRENT mean
    // units. Delaying only this denominator shifts every pixel together and
    // can erase all visible bands during uniform dimming. Boundaries/colors,
    // not the conversion between coordinate units, own temporal continuity.
    float displayScale = scale;
    float finiteEnd = max(maximum, hasHistory ? oldInfo.w : maximum) + 1.0;

    if (!hasHistory)
    {
        [loop] for (uint i = 0u; i < targetCount; ++i)
        {
            rUpper[i] = rGoalUpper[i] = rTargetUpper[i];
            rColor[i] = rGoalColor[i] = rTargetColor[i];
            rGoalIndex[i] = i;
        }
    }
    else
    {
        regions = (uint)oldHeader.y;
        goalCount = (uint)oldHeader.z;
        remaining = max(oldHeader.w, 0.0);
        [loop] for (uint i = 0u; i < regions; ++i)
        {
            uint entry = oldAddress + TONE_REGION_HEADER + i * 3u;
            float4 bounds = _TonePreviousRegions[entry];
            rUpper[i] = bounds.x;
            rGoalUpper[i] = bounds.y;
            rGoalIndex[i] = (uint)bounds.z;
            rColor[i] = _TonePreviousRegions[entry + 1u];
            rGoalColor[i] = _TonePreviousRegions[entry + 2u];
        }

        if (remaining <= 0.0 && regions != targetCount)
        {
            // Monotone common refinement of interval ranks. Duplicate an old
            // interval to split it (same initial color, initially zero width).
            // Duplicate a target interval to merge (same final color/boundary).
            // At most oldK+newK-1 <= 63 intervals; no accumulating ghost bands.
            uint oldCount = regions;
            uint oldIndex = 0u, targetIndex = 0u;
            regions = 0u;
            [loop] while (oldIndex < oldCount && targetIndex < targetCount)
            {
                uint entry = oldAddress + TONE_REGION_HEADER + oldIndex * 3u;
                float startUpper = _TonePreviousRegions[entry].x;
                float endUpper = rTargetUpper[targetIndex];
                bool finalPair = oldIndex + 1u == oldCount && targetIndex + 1u == targetCount;
                rUpper[regions] = finalPair ? TONE_INF : min(startUpper, finiteEnd);
                rGoalUpper[regions] = finalPair ? TONE_INF : min(endUpper, finiteEnd);
                rColor[regions] = _TonePreviousRegions[entry + 1u];
                rGoalColor[regions] = rTargetColor[targetIndex];
                rGoalIndex[regions] = targetIndex;
                ++regions;
                // Integer cross multiplication avoids nearly equal float ranks
                // choosing inconsistent paths between GPUs.
                uint oldRank = (oldIndex + 1u) * targetCount;
                uint newRank = (targetIndex + 1u) * oldCount;
                if (oldRank <= newRank) ++oldIndex;
                if (newRank <= oldRank) ++targetIndex;
            }
            goalCount = targetCount;
            remaining = _ToneRegionSeconds;
        }
        else if (remaining <= 0.0)
        {
            // No topology event: track live colors and contours in seconds.
            // This is per-region palette state, not per-pixel RGB history.
            [loop] for (uint i = 0u; i < regions; ++i)
            {
                rGoalUpper[i] = rTargetUpper[i];
                rGoalColor[i] = rTargetColor[i];
                rUpper[i] = i + 1u == regions ? TONE_INF : lerp(rUpper[i], rGoalUpper[i], response);
                rColor[i].rgb = lerp(rColor[i].rgb, rGoalColor[i].rgb, response);
                rGoalIndex[i] = i;
            }
        }

        if (remaining > 0.0)
        {
            // Complete a finite transition before accepting another topology.
            // Replacing the goal every frame recreates the original popping.
            float step = saturate(dt / remaining);
            [loop] for (uint i = 0u; i < regions; ++i)
            {
                rUpper[i] = i + 1u == regions ? TONE_INF : lerp(rUpper[i], rGoalUpper[i], step);
                rColor[i].rgb = lerp(rColor[i].rgb, rGoalColor[i].rgb, step);
            }
            remaining = max(0.0, remaining - dt);
            if (remaining <= 1e-6)
            {
                // Compact only after colors agree and duplicate widths reach
                // zero. No hand/coverage/outline cell is ever removed here.
                uint compactCount = 0u, lastGoal = 0xffffffffu;
                [loop] for (uint i = 0u; i < regions; ++i)
                {
                    uint goal = rGoalIndex[i];
                    if (goal == lastGoal) continue;
                    rUpper[compactCount] = rGoalUpper[compactCount] = rGoalUpper[i];
                    rColor[compactCount] = rGoalColor[compactCount] = rGoalColor[i];
                    rGoalIndex[compactCount] = goal;
                    lastGoal = goal;
                    ++compactCount;
                }
                regions = compactCount;
                rUpper[regions - 1u] = rGoalUpper[regions - 1u] = TONE_INF;
                remaining = 0.0;
            }
        }
    }

    // A highlight has an independent existence gate in the old solver. It
    // must use the same temporal policy instead of bypassing the region stage.
    float4 highlight = _ToneSolutions[group * 3u + 1u];
    float targetWeight = highlight.w > .5 ? 1.0 : 0.0;
    float4 oldAccent = hasHistory ? _TonePreviousRegions[oldAddress + 2u] : 0.0;
    float3 accentColor = _ToneSolutions[group * 3u + 2u].rgb;
    if (targetWeight == 0.0) accentColor = oldAccent.rgb;
    float weight = hasHistory ? lerp(oldAccent.a, targetWeight, response) : targetWeight;
    if (abs(weight - targetWeight) < 1e-4) weight = targetWeight;
    float3 displayedAccent = hasHistory && oldAccent.a > 0.0 ? lerp(oldAccent.rgb, accentColor, response) : accentColor;
    float cutoff = max(highlight.z, .5 * (highlight.x + highlight.y)) / scale;
    if (targetWeight == 0.0 && hasHistory) cutoff = _TonePreviousRegions[oldAddress + 3u].x;
    float displayedCutoff = hasHistory && oldAccent.a > 0.0 ?
        lerp(_TonePreviousRegions[oldAddress + 3u].x, cutoff, response) : cutoff;
    _ToneNextRegions[address + 2u] = float4(displayedAccent, weight);
    _ToneNextRegions[address + 3u] = float4(displayedCutoff, 0, 0, 0);
    [unroll] for (uint block = 0u; block < 4u; ++block)
    {
        float4 supports = 0.0;
        [unroll] for (uint j = 0u; j < 4u; ++j)
            supports[j] = (_ToneSupports[group * 2u + 1u] & (1u << (block * 4u + j))) != 0u ? 1.0 : 0.0;
        _ToneNextRegions[address + 4u + block] = hasHistory ?
            lerp(_TonePreviousRegions[oldAddress + 4u + block], supports, response) : supports;
    }
    [loop] for (uint i = 0u; i < regions; ++i)
    {
        uint entry = address + TONE_REGION_HEADER + i * 3u;
        _ToneNextRegions[entry] = float4(rUpper[i], rGoalUpper[i], rGoalIndex[i], 0);
        _ToneNextRegions[entry + 1u] = float4(rColor[i].rgb, 0);
        _ToneNextRegions[entry + 2u] = float4(rGoalColor[i].rgb, 0);
    }
    _ToneNextRegions[address + 1u] = float4(1, HistoryMetricMode(group), displayScale, maximum);
    _ToneNextRegions[address] = float4(asfloat(_ToneGroups[group * 8u]), regions, goalCount, remaining);
}

[numthreads(8, 8, 1)]
void Resolve(uint3 id : SV_DispatchThreadID)
{
    if (!InBounds(id.xy)) return;
    float4 original = _ToneCellColor.Load(int3(id.xy, 0));
    _ToneOutput[id.xy] = original;
    // Resolve-only key-miss bit does not alter another invocation's decision.
    if ((_ToneStatus[TONE_GROUPS] & 95u) != 0u) return;
    float4 meta = _ToneCellMeta.Load(int3(id.xy, 0));
    if (Subject(meta) != (uint)_ToneSubjectId || original.a <= 0.0) return;
    if (!ValidColorDepth(original)) { InterlockedOr(_ToneStatus[TONE_GROUPS], 32u); return; }
    float3 lab = LinearToOklab(original.rgb);
    float metric;
    if (!TryAnalysisMetric(id.xy, lab, meta, metric))
    { InterlockedOr(_ToneStatus[TONE_GROUPS], 32u); return; }
    uint key = ColorKey(lab, meta, id.xy);
    uint group = key == 0u ? TONE_GROUPS : FindGroup(key);
    if (group >= TONE_GROUPS) { InterlockedOr(_ToneStatus[TONE_GROUPS], 32u); return; }
    if ((_ToneStatus[group] & 1u) == 0u) return;
    if (_ToneRegionTransitions != 0)
    {
        uint address = group * TONE_REGION_STRIDE;
        float4 header = _ToneDisplayRegions[address];
        float4 info = _ToneDisplayRegions[address + 1u];
        if (info.x != 1.0 || asuint(header.x) != key || info.z <= 0.0)
        { InterlockedOr(_ToneStatus[TONE_GROUPS], 32u); return; }
        float coordinate = metric / info.z;
        uint region = (uint)header.y - 1u;
        [loop] for (uint i = 0u; i < (uint)header.y; ++i)
            if (coordinate <= _ToneDisplayRegions[address + TONE_REGION_HEADER + i * 3u].x)
            { region = i; break; }
        float3 color = _ToneDisplayRegions[address + TONE_REGION_HEADER + region * 3u + 1u].rgb;
        float4 accent = _ToneDisplayRegions[address + 2u];
        uint tile = SpatialTile(id.xy, group);
        float support = _ToneDisplayRegions[address + 4u + tile / 4u][tile % 4u];
        // Support controls the spatial contour, not an on/off .5 gate. Start
        // beyond the current field's maximum and progressively reveal the
        // highlight range, retaining the same flat accent color throughout.
        float accentCutoff = _ToneDisplayRegions[address + 3u].x;
        float2 actualRange = LightnessRange(group);
        float closedCutoff = max(accentCutoff,
            (actualRange.x + actualRange.y + _ToneHighlightMinimumContrast) / info.z);
        float supportedCutoff = lerp(closedCutoff, accentCutoff, saturate(support));
        if (accent.a > 0.0 && coordinate >= supportedCutoff)
            color = lerp(color, accent.rgb, accent.a);
        _ToneOutput[id.xy] = float4(color, original.a);
        return;
    }
    uint bin = LightnessBin(NormalizeL(metric, LightnessRange(group)));
    float4 base = _TonePalette[group * TONE_BINS + bin];
    // A missing dense-source bin is a source/seed contract mismatch. Zero RGB
    // cannot serve as an invented substitute, including when the source is black.
    if (base.a < 0.0)
    { InterlockedOr(_ToneStatus[TONE_GROUPS], 32u); return; }
    float4 highlight = _ToneSolutions[group * 3u + 1u];
    uint tile = SpatialTile(id.xy, group);
    bool supported = (_ToneSupports[group * 2u + 1u] & (1u << tile)) != 0u;
    if (highlight.w > .5 && supported && base.a == highlight.x && metric >= highlight.z &&
        metric >= .5 * (highlight.x + highlight.y))
        base.rgb = _ToneSolutions[group * 3u + 2u].rgb;
    _ToneOutput[id.xy] = float4(base.rgb, original.a);
}

[numthreads(32, 1, 1)]
void StoreHistory(uint3 workgroup : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint group = workgroup.x;
    if (group >= TONE_GROUPS || lane != 0u) return;
    uint address = group * TONE_HISTORY_STRIDE;
    // One lane clears and publishes each group's entire record. Shared-memory
    // barriers do not synchronize UAV clears performed by different lanes.
    [fastopt] [loop] for (uint entry = 0u; entry < TONE_HISTORY_STRIDE; ++entry)
        _ToneNextHistory[address + entry] = 0.0;
    if (_ToneTemporalStability == 0 || _ToneStatus[TONE_GROUPS] != 0u ||
        (_ToneStatus[group] & 1u) == 0u || _ToneGroups[group * 8u] == 0u ||
        _ToneSolutions[group * 3u].x < 1.0) return;

    float count = 0.0, sum = 0.0;
    [fastopt] [loop] for (uint historyBin = 0u; historyBin < TONE_BINS; ++historyBin)
    {
        uint histogram = (group * TONE_BINS + historyBin) * 6u;
        count += _ToneHistogram[histogram];
        sum += PairValue(_ToneHistogram[histogram + 1u], _ToneHistogram[histogram + 2u]) / TONE_Q;
    }
    if (count <= 0.0) return;
    float2 range = LightnessRange(group);
    float scale = HistoryMetricScale(group, range, sum / count);
    uint intervals = 0u;
    uint lastBin = 0u;
    float4 previous = float4(0.0, 0.0, 0.0, -1.0);
    [fastopt] [loop] for (uint b = 0u; b < TONE_BINS; ++b)
    {
        if (_ToneHistogram[(group * TONE_BINS + b) * 6u] == 0u) continue;
        float4 value = _TonePalette[group * TONE_BINS + b];
        if (value.a < 0.0 || !all(isfinite(value))) return;
        if (previous.a >= 0.0 && any(value != previous))
        {
            // Put a boundary between occupied bins, including an empty-bin gap.
            // It is stored in physical metric / mean scale, never as a bin ID.
            float boundary = range.x + ((float)(lastBin + 1u + b) * .5 / TONE_BINS) * range.y;
            _ToneNextHistory[address + 2u + intervals] = float4(boundary / scale, previous.a / scale, 0.0, 0.0);
            ++intervals;
        }
        previous = value;
        lastBin = b;
    }
    if (previous.a < 0.0) return;
    _ToneNextHistory[address + 2u + intervals] = float4(TONE_INF, previous.a / scale, 0.0, 0.0);
    ++intervals;
    _ToneNextHistory[address + 1u] = float4(scale, range.x, range.x + range.y, 0.0);
    // Publish validity last. Resolve-only source/seed failures invalidate the
    // entire frame's history because this kernel executes after Resolve.
    _ToneNextHistory[address] = float4(asfloat(_ToneGroups[group * 8u]),
        (float)intervals, (float)HistoryMetricMode(group), 1.0);
}
