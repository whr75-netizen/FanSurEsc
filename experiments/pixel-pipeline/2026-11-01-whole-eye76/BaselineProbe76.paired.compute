bool NativeLineAllocated19(int2 p,int eye){
 FeaturePacket19 own=Packet19(p,eye);if(own.b.y<=0||IrisAllocated19(p,eye))return false;
 int whiteCandidates=0;float area=0;int reserved76=0;
 for(int sumY=_ROI348.y;sumY<_ROI348.y+_ROI348.w;sumY++)for(int sumX=_ROI348.x;sumX<_ROI348.x+_ROI348.z;sumX++){
  int2 cell=int2(sumX,sumY);FeaturePacket19 c=Packet19(cell,eye);area+=c.b.y/16;
#ifndef ORIGINAL76
  if(c.uv.z>.5)reserved76++;
#endif

