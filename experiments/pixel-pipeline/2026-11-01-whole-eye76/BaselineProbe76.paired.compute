int ChooseLayers19(float c[8],int2 p,int eye,int curveFeature){
 if(IrisAllocated19(p,eye)){if(c[4]>=4)return 4;return c[2]>=c[3]?2:3;}
 if(NativeLineAllocated19(p,eye))return 5;
 // Keep the approved non-iris curve choice where its own mesh still supports it.
 // Correcting iris support is not permission to redesign white or lid pixels.
 if(curveFeature==1&&c[1]>0)return 1;
 
 if(curveFeature==6&&c[6]>0)return 6;
 float other[8];for(int i=0;i<8;i++)other[i]=c[i];other[2]=other[3]=other[4]=other[5]=other[7]=0;int w=Choose(other);
 // Approved326 white-neighbour preservation, using semantic coverage, not RGB.
