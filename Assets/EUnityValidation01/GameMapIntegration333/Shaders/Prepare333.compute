#pragma kernel NativeColour
#pragma kernel Prepare
#pragma kernel Resolve
Texture2D<float4> _Raw,_Physical,_Original,_RawMeta,_RawUV,_Surface,_Palette,_Map,_NativeInput,_CentreRaw,_CentrePhysical,_CentreOriginal,_CentreMeta,_CentreUV,_CentreSurface,_CentrePalette;
RWTexture2D<float4> _Native,_Before,_Colour,_Owner,_Audit,_GridSurface,_GridPalette,_PreparedUV,_PreparedMeta,_ResolvedMeta,_ResolvedUV;
Texture2D<float4> _EyeDomain;
float4 _Profile;int _ContourMode;
[numthreads(8,8,1)]void NativeColour(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(960,544)))return;float4 s=_Raw.Load(int3(p,0)),ph=_Physical.Load(int3(p,0)),m=_RawMeta.Load(int3(p,0));int role=round(m.y)-1;float lit=step(_Profile.y,ph.x)*step(_Profile.z,ph.y);_Native[p]=role>=7&&role<=10?float4(s.rgb*((_Profile.w>.5&&lit<.5)?_Profile.x:1),s.a):_Original.Load(int3(p,0));}
[numthreads(8,8,1)]void Prepare(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;int2 n=2*p+1;float4 a=_ContourMode>0?_Map.Load(int3(p,0)):0;if(a.r>.5&&a.a>.5)n=round(a.gb);bool added=a.r>.5&&a.a>.5;float4 m=added?_Surface.Load(int3(n,0)):_CentreSurface.Load(int3(p,0)),f=added?_Palette.Load(int3(n,0)):_CentrePalette.Load(int3(p,0)),r=added?_RawMeta.Load(int3(n,0)):_CentreMeta.Load(int3(p,0)),uv=added?_RawUV.Load(int3(n,0)):_CentreUV.Load(int3(p,0));float4 c;if(added)c=_NativeInput.Load(int3(n,0));else{float4 s=_CentreRaw.Load(int3(p,0)),ph=_CentrePhysical.Load(int3(p,0));int role=round(r.y)-1;float lit=step(_Profile.y,ph.x)*step(_Profile.z,ph.y);c=role>=7&&role<=10?float4(s.rgb*((_Profile.w>.5&&lit<.5)?_Profile.x:1),s.a):_CentreOriginal.Load(int3(p,0));}if(a.r<-.5&&a.a>.5){m=0;f=0;c=0;r=0;uv=0;}c.a=m.x>0?1:0;_Before[p]=c;_Colour[p]=c;_Owner[p]=float4(m.y,m.z,m.x,m.w);_Audit[p]=0;float4 currentPhysical=added?_Physical.Load(int3(n,0)):_CentrePhysical.Load(int3(p,0));float currentLit=step(_Profile.y,currentPhysical.x)*step(_Profile.z,currentPhysical.y);_PreparedUV[p]=float4(uv.xy,currentLit,1);_PreparedMeta[p]=r;for(int y=0;y<2;y++)for(int x=0;x<2;x++){int2 q=2*p+int2(x,y);_GridSurface[q]=m;_GridPalette[q]=f;}}
[numthreads(8,8,1)]void Resolve(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(any(p>=int2(480,272)))return;float4 o=_Owner[p],r=_PreparedMeta[p];_ResolvedMeta[p]=float4(o.z,o.x,r.z,o.w);_ResolvedUV[p]=_PreparedUV[p];}
