# Preserve source/evidence bytes across checkout configurations.
* -text
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Frozen capture/candidate sources retain original EOF and patch whitespace.
archive/*.cs whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
archive/candidate/* whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
