float4 template262(float2 p,int eye){if((eye==0?_Visible262_0:_Visible262_1)==0)return 0;float2 q=local262(p,eye);if(!inside295(q,eye,false))return 0;return float4(inside295(q,eye,true)?1:4,eye==0?2:1,0,0);}
float4 ownColour295(float2 q,int eye,int role,out int support){int owner=eye==0?2:1;int2 k=(int2)floor(q);if(all(k>=0)&&all(k<_TemplateSize)){float4 r=_TemplateRole.Load(int3(k.x,_TemplateSize.y-1-k.y,0));if(round(r.x)==role&&round(r.y)==owner){support=1;return _TemplateRGBA.Load(int3(k.x,_TemplateSize.y-1-k.y,0));}}
