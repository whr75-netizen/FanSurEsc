#pragma kernel Seed
#pragma kernel Flood
#pragma kernel OwnerLines
#pragma kernel FloodTile
Texture2D<float4> _Before,_Owner,_Surface,_Torso,_Arms,_TriangleVertices,_Palette256;
Texture2D<uint> _FloodRead;RWTexture2D<uint> _FloodWrite;RWTexture2D<float4> _Colour,_Audit,_PaletteAudit256;int2 _Size;float _LineTone;int _UsePalette256;float4 _DeepCream256,_DeepSkin256;
int _ClosedDomain553,_ClosedParts553,_HeadScope553,_BodyCount553;StructuredBuffer<float> _BodySource553;
int _CleanOutline399;
// A managed closed domain has boundaries against every empty component,
// including an enclosed hole. Connectivity to the canvas is not its boundary.
bool closedDomain553(float4 owner){int part=(int)round(owner.x)-8;if(_ClosedDomain553==0||part<0||part>3||(_ClosedParts553&(1<<part))==0)return false;if(part==0&&_HeadScope553!=0){int i=(int)round(abs(owner.w))-1;if(i<0||i>=_BodyCount553)return false;return _BodySource553[i]>.5;}return true;}
bool inside(int2 p){return all(p>=0)&&all(p<_Size);}bool covered(int2 p){return inside(p)&&_Before.Load(int3(p,0)).a>0;}uint ext(int2 p){return inside(p)?_FloodRead.Load(int3(p,0)):1;}
[numthreads(8,8,1)]void Seed(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(!inside(p))return;_FloodWrite[p]=!covered(p)&&(p.x==0||p.y==0||p.x==_Size.x-1||p.y==_Size.y-1)?1:0;}
[numthreads(8,8,1)]void Flood(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(!inside(p))return;_FloodWrite[p]=covered(p)?0:(ext(p)|ext(p+int2(-1,0))|ext(p+int2(1,0))|ext(p+int2(0,-1))|ext(p+int2(0,1)));}
groupshared uint _FloodCov[18][18];
groupshared uint _FloodTileA[18][18];
groupshared uint _FloodTileB[18][18];
[numthreads(16,16,1)]void FloodTile(uint3 gtid:SV_GroupThreadID,uint3 dtid:SV_DispatchThreadID){
 int lx=(int)gtid.x+1,ly=(int)gtid.y+1;int2 p=int2(dtid.xy);
 bool cov=covered(p);_FloodCov[ly][lx]=cov?1u:0u;_FloodTileA[ly][lx]=cov?0u:ext(p);
 if(gtid.x==0){int2 h=p+int2(-1,0);bool c=covered(h);_FloodCov[ly][0]=c?1u:0u;_FloodTileA[ly][0]=c?0u:ext(h);_FloodTileB[ly][0]=_FloodTileA[ly][0];}
 if(gtid.x==15){int2 h=p+int2(1,0);bool c=covered(h);_FloodCov[ly][17]=c?1u:0u;_FloodTileA[ly][17]=c?0u:ext(h);_FloodTileB[ly][17]=_FloodTileA[ly][17];}
 if(gtid.y==0){int2 h=p+int2(0,-1);bool c=covered(h);_FloodCov[0][lx]=c?1u:0u;_FloodTileA[0][lx]=c?0u:ext(h);_FloodTileB[0][lx]=_FloodTileA[0][lx];}
 if(gtid.y==15){int2 h=p+int2(0,1);bool c=covered(h);_FloodCov[17][lx]=c?1u:0u;_FloodTileA[17][lx]=c?0u:ext(h);_FloodTileB[17][lx]=_FloodTileA[17][lx];}
 GroupMemoryBarrierWithGroupSync();
 [unroll]for(int iter=0;iter<8;iter++){
  _FloodTileB[ly][lx]=_FloodCov[ly][lx]!=0u?0u:(_FloodTileA[ly][lx]|_FloodTileA[ly][lx-1]|_FloodTileA[ly][lx+1]|_FloodTileA[ly-1][lx]|_FloodTileA[ly+1][lx]);
  GroupMemoryBarrierWithGroupSync();
  _FloodTileA[ly][lx]=_FloodCov[ly][lx]!=0u?0u:(_FloodTileB[ly][lx]|_FloodTileB[ly][lx-1]|_FloodTileB[ly][lx+1]|_FloodTileB[ly-1][lx]|_FloodTileB[ly+1][lx]);
  GroupMemoryBarrierWithGroupSync();
 }
 if(inside(p))_FloodWrite[p]=_FloodTileA[ly][lx];
}
int partAt(int2 p){return covered(p)?(int)round(_Owner.Load(int3(p,0)).y):0;}
bool ownCore(int2 p,int2 inward,int part){bool a=covered(p+inward),b=covered(p+inward*2);if(part>=2&&part<=5){a=a&&partAt(p+inward)==part;b=b&&partAt(p+inward*2)==part;}return a&&b;}
bool hasThreeInAxis(int2 p,int2 d,int part){bool a=partAt(p-d)==part,b=partAt(p+d)==part;return (a&&b)||(a&&partAt(p-d*2)==part)||(b&&partAt(p+d*2)==part);}
bool sameSourceConnection(float a,float b){int ia=(int)round(abs(a)),ib=(int)round(abs(b));if(ia<1||ib<1)return false;float3 va=_TriangleVertices.Load(int3(ia,0,0)).xyz,vb=_TriangleVertices.Load(int3(ib,0,0)).xyz;return any(va.xxx==vb)||any(va.yyy==vb)||any(va.zzz==vb);}
bool torsoCore(int2 p,int2 inward){return covered(p+inward)&&covered(p+2*inward)&&partAt(p+inward)==1&&partAt(p+2*inward)==1;}
bool isOpenEmpty399(int2 q){
 if(covered(q))return false;
 if(ext(q)>0)return true;
 // Enclosed empty gap (e.g. between sleeve and torso): treat as open boundary unless it is an isolated 1px interior pinhole.
 return !covered(q+int2(-1,0))||!covered(q+int2(1,0))||!covered(q+int2(0,-1))||!covered(q+int2(0,1));
}
[numthreads(8,8,1)]void OwnerLines(uint3 id:SV_DispatchThreadID){int2 p=id.xy;if(!inside(p))return;float4 c=_Before.Load(int3(p,0)),owner=_Owner.Load(int3(p,0));int role=(int)round(owner.x)-1,part=(int)round(owner.y);bool eligible=role==7||role==8||role==9||role==10||role>=11;int2 dirs[4]={int2(-1,0),int2(1,0),int2(0,-1),int2(0,1)};bool outer=false,internal=false,thin=false,joint=false;
 if(covered(p)&&eligible){bool closed=closedDomain553(owner);
  if(_CleanOutline399!=0){
   for(int i=0;i<4;i++){int2 d=dirs[i];if(closed?!covered(p+d):isOpenEmpty399(p+d))outer=true;}
   // Only suppress outer outline on 1px-thin bare skin strands (fingers/wrists), NEVER on clothing/sleeves/corners.
   if(outer&&role==7&&part>=2&&part<=5){
    bool pinchX=!covered(p+int2(-1,0))&&!covered(p+int2(1,0));
    bool pinchY=!covered(p+int2(0,-1))&&!covered(p+int2(0,1));
    if(pinchX||pinchY)thin=true;
   }
  }else{
   for(int i=0;i<4;i++){int2 d=dirs[i];if(closed?!covered(p+d):ext(p+d)>0){outer=true;if(!ownCore(p,-d,part))thin=true;}}
  }
  if(!outer&&(part==2||part==3)){float4 front=_Surface.Load(int3(p*2+1,0)),under=_Torso.Load(int3(p,0));bool underTorso=under.x>0&&round(under.z)==1&&under.x>front.x;
   if(underTorso)for(int i=0;i<4;i++){int2 d=dirs[i];float4 other=inside(p+d)?_Owner.Load(int3(p+d,0)):0;if(covered(p+d)&&round(other.y)==1&&other.z>front.x){if(front.w<0)joint=true;else if(ownCore(p,-d,part))internal=true;else thin=true;}}
  }
  // Missing opposite ownership: the clothed torso is foreground and the far arm is behind it.
  // A skin-weight blend flag does not establish a shared physical joint. Keep only exact source-vertex connectivity as the joint guard for this newly connected direction.
  if(!outer&&part==1&&role==10){float4 front=_Surface.Load(int3(p*2+1,0)),under=_Arms.Load(int3(p,0));bool armBehind=under.x>front.x&&under.x>0&&(round(under.z)==2||round(under.z)==3);
   if(armBehind)for(int i=0;i<4;i++){int2 d=dirs[i];float4 other=inside(p+d)?_Owner.Load(int3(p+d,0)):0;
    if(covered(p+d)&&round(other.x)==11&&round(other.y)==round(under.z)&&other.z>front.x){bool connected=sameSourceConnection(front.w,under.w)||sameSourceConnection(front.w,other.w);if(connected)joint=true;else if(torsoCore(p,-d))internal=true;}
   }
  }
 }
 if(_CleanOutline399==0&&covered(p)&&part>=2&&part<=5&&(!hasThreeInAxis(p,int2(1,0),part)||!hasThreeInAxis(p,int2(0,1),part)))thin=true;
 if(_CleanOutline399!=0&&!outer&&covered(p)&&part>=2&&part<=5&&(!hasThreeInAxis(p,int2(1,0),part)||!hasThreeInAxis(p,int2(0,1),part)))thin=true;
 int reason=outer&&!thin&&eligible?1:internal&&!thin?2:0;
 // One colour from the nearest foreground cell, one darker step of the existing .55 linear own-colour ramp.
 // No neighbouring RGB averaging, role-wide fixed ink, normal-only edge or shadow-terminator edge.
 float4 pa=0;if(reason>0){c.rgb=c.rgb*_LineTone;bool scope=(part==2||part==3)||(reason==2&&part==1);float4 family=_Palette256.Load(int3(p*2+1,0));bool own=family.w>0&&round(family.y)==round(owner.x)&&abs(family.z-owner.z)<=.00002;if(_UsePalette256>0&&scope&&own){if(round(family.x)==3){c.rgb=_DeepCream256.rgb;pa=float4(1,3,owner.x,1);}else if(round(family.x)==1){c.rgb=_DeepSkin256.rgb;pa=float4(1,1,owner.x,1);}}} _PaletteAudit256[p]=pa;_Colour[p]=c;_Audit[p]=float4(reason,outer?1:0,thin?1:0,joint?1:0);
}
