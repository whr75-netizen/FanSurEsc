  FeatureSample583 baseSample=Sample583(p,eye,k);FeatureSample583 lash=baseSample;if(closed)lash=CurveSample590(p,eye,k);
  if(lash.feat==5&&lash.support>=0&&lash.weight>0){counts.x+=lash.weight;float3 d=lash.rest-_Centres348[eye].xyz;curveMean+=lash.weight*float2(dot(d,_AxesX348[eye].xyz)/_AxesX348[eye].w,-dot(d,_AxesY348[eye].xyz)/_AxesY348[eye].w);}
