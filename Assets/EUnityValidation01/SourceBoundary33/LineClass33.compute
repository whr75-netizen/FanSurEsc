#pragma kernel Classify31
// Typed initial-Q evidence; Q and metadata come from ONE fragment/MRT pair.
Texture2D<float4> _Outline29,_Pigment29,_Q31,_QMeta31;
RWTexture2D<float4> _Class29;
int4 _Rect29,_QRect31; // top-left head logical ROI, integer extents
bool Face31(int2 p){if(any(p<0)||any(p>=_QRect31.zw))return false;float4 m=_QMeta31.Load(int3(p,0));return m.x>0&&round(m.y)==4&&m.a>0;}
bool Known31(int2 p,float4 q){if(!Face31(p))return false;float4 m=_QMeta31.Load(int3(p,0));return all(isfinite(q))&&q.a>0&&q.z==m.x&&q.a==m.a;}
[numthreads(8,8,1)]void Classify31(uint3 id:SV_DispatchThreadID){
 int2 p=id.xy;if(any(p>=_Rect29.zw))return;
 float outline=0,pigment=0;
 [unroll]for(int y=0;y<8;y++)[unroll]for(int x=0;x<8;x++){int2 fine=8*p+int2(x,y);outline+=_Outline29.Load(int3(fine,0)).a;pigment+=_Pigment29.Load(int3(fine,0)).a;}
 int2 physical=int2(_Rect29.x+p.x,272-_Rect29.y-_Rect29.w+p.y);
 int2 qpos=physical-int2(_QRect31.x,272-_QRect31.y-_QRect31.w);
 float4 q=_Q31.Load(int3(qpos,0));bool face=Face31(qpos),known=Known31(qpos,q);float transition=0;
 int2 dirs[4]={int2(-1,0),int2(1,0),int2(0,-1),int2(0,1)};
 [unroll]for(int k=0;k<4;k++){int2 n=qpos+dirs[k];if(all(n>=0)&&all(n<_QRect31.zw)){float4 other=_Q31.Load(int3(n,0));if(known&&Known31(n,other)&&other.x!=q.x)transition=1;}}
 uint flags=(face?1:0)|2|(known?4:0)|8;
 _Class29[p]=float4(outline/64,pigment/64,transition,flags);
}
