 }
 float4 m=_ShadeMeta335.Load(int3(p,0));if(!ShadeRole335(m))return;
 float4 mask=_ShadeMaskRead335.Load(int3(p,0)),cls=_ShadeClassOut335[p];
 float old=cls.x,q=mask.x;if(abs(old-q)<.01)return;
 int role=round(m.y)-1;float3 minimum=role==3?_ShadeFaceMinimum335.rgb:_ShadeFloor335.xxx;
 float2 uv=_ShadeUV335.Load(int3(p,0)).xy;
 if(role==7&&_StockMember335.SampleLevel(sampler_StockMember335,uv,0).r>.5)minimum=_ShadeStockMinimum335.rgb;
 float4 factor=float4(_ShadeEnabled335!=0?lerp(minimum,1,q):1,cls.a);
 float4 colour=_ShadeLit335.Load(int3(p,0));cls.x=q;
 float3 result=colour.rgb*factor.rgb;
 if(role>=11&&role<=14){factor.rgb=_ShadeEnabled335!=0?HairAnchor335()*lerp(_ShadeFloor335,1,q):1;result=HairFinal335(colour.rgb,q,_ShadeFloor335,_ShadeEnabled335!=0);}
 if(_ShadeView335==1)result=colour.rgb;
 if(_ShadeView335==2)result=cls.yyy;
 if(_ShadeView335==3)result=q.xxx;
 _ShadeColourOut335[p]=float4(result,colour.a);_ShadeFactorOut335[p]=factor;_ShadeClassOut335[p]=cls;
